{
  "$id": "https://verigym.dev/schemas/1.0/contamination-scan-policy.schema.json",
  "additionalProperties": false,
  "properties": {
    "code_sequence_min_tokens": {
      "default": 5,
      "minimum": 3,
      "title": "Code Sequence Min Tokens",
      "type": "integer"
    },
    "distinctive_identifier_min_characters": {
      "default": 5,
      "minimum": 3,
      "title": "Distinctive Identifier Min Characters",
      "type": "integer"
    },
    "hidden_reference_output": {
      "const": "hash_only",
      "default": "hash_only",
      "title": "Hidden Reference Output",
      "type": "string"
    },
    "known_match_classes": {
      "items": {
        "enum": [
          "task_identity_overlap",
          "source_identity_overlap",
          "exact_file_content",
          "issue_text_duplication",
          "source_code_sequence",
          "hidden_test_fragment",
          "reference_patch_fragment",
          "exact_task_id",
          "repository_path",
          "distinctive_identifier",
          "heldout_issue_phrase",
          "allowed_synthesis_vocabulary",
          "generic_vocabulary"
        ],
        "type": "string"
      },
      "title": "Known Match Classes",
      "type": "array"
    },
    "natural_language_min_characters": {
      "default": 20,
      "minimum": 20,
      "title": "Natural Language Min Characters",
      "type": "integer"
    },
    "natural_language_min_tokens": {
      "default": 5,
      "minimum": 3,
      "title": "Natural Language Min Tokens",
      "type": "integer"
    },
    "policy_hash": {
      "title": "Policy Hash",
      "type": "string"
    },
    "policy_id": {
      "const": "provenance_aware_contamination_v1",
      "default": "provenance_aware_contamination_v1",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_fragment_min_lines": {
      "default": 5,
      "minimum": 3,
      "title": "Source Fragment Min Lines",
      "type": "integer"
    },
    "tokenizer_id": {
      "const": "ascii_casefold_lexical_v1",
      "default": "ascii_casefold_lexical_v1",
      "title": "Tokenizer Id",
      "type": "string"
    },
    "unknown_match_policy": {
      "const": "fail_closed",
      "default": "fail_closed",
      "title": "Unknown Match Policy",
      "type": "string"
    }
  },
  "required": [
    "known_match_classes",
    "policy_hash"
  ],
  "title": "ContaminationScanPolicy",
  "type": "object"
}
