      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "server_contract_hash": {
      "title": "Server Contract Hash",
      "type": "string"
    },
    "server_declared_profile_hash": {
      "title": "Server Declared Profile Hash",
      "type": "string"
    },
    "server_profile_id": {
      "title": "Server Profile Id",
      "type": "string"
    },
    "server_version": {
      "title": "Server Version",
      "type": "string"
    },
    "service_protocol": {
      "title": "Service Protocol",
      "type": "string"
    },
    "source_plugin": {
      "title": "Source Plugin",
      "type": "string"
    },
    "target_plugin": {
      "title": "Target Plugin",
      "type": "string"
    },
