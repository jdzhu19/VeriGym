{
  "$id": "https://verigym.dev/schemas/1.0/trajectory-index-record.schema.json",
  "additionalProperties": false,
  "properties": {
    "agent_version_id": {
      "title": "Agent Version Id",
      "type": "string"
    },
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "outcome_kind": {
      "enum": [
        "resolved_candidate",
        "incorrect_policy_compliant_candidate",
        "contained_workspace_policy_failure",
        "strict_output_failure",
        "infrastructure_invalid",
        "cancelled_or_interrupted"
      ],
      "title": "Outcome Kind",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "training",
        "validation",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "trajectory_hash": {
      "title": "Trajectory Hash",
      "type": "string"
    },
    "trajectory_id": {
      "title": "Trajectory Id",
      "type": "string"
    }
  },
  "required": [
    "trajectory_id",
    "run_id",
    "task_id",
    "split",
    "agent_version_id",
    "eligible",
    "outcome_kind",
    "trajectory_hash"
  ],
  "title": "TrajectoryIndexRecord",
  "type": "object"
}
