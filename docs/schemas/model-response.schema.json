{
  "$defs": {
    "ModelClientErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ModelErrorCategory"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "provider_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Code"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "ModelClientErrorInfo",
      "type": "object"
    },
    "ModelErrorCategory": {
      "enum": [
        "configuration",
        "authentication",
        "timeout",
        "output_limit",
        "transport",
        "rate_limit",
        "invalid_response",
        "exhausted",
        "internal"
      ],
      "title": "ModelErrorCategory",
      "type": "string"
    },
    "ModelFinishReason": {
      "enum": [
        "stop",
        "length",
        "tool_call",
        "content_filter",
        "error",
        "unknown"
      ],
      "title": "ModelFinishReason",
      "type": "string"
    },
    "NormalizedModelUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "NormalizedModelUsage",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/model-response.schema.json",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelClientErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finish_reason": {
      "$ref": "#/$defs/ModelFinishReason",
      "default": "unknown"
    },
    "latency_s": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Latency S",
      "type": "number"
    },
    "provider_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Model Id"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "response_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Id"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "system_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Fingerprint"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/NormalizedModelUsage"
    }
  },
  "required": [
    "request_id",
    "text"
  ],
  "title": "ModelResponse",
  "type": "object"
}
