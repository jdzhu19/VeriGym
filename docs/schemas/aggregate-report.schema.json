          "title": "Partition Id",
          "type": "string"
        },
        "planned_count": {
          "minimum": 0,
          "title": "Planned Count",
          "type": "integer"
        },
        "resolved_count": {
          "minimum": 0,
          "title": "Resolved Count",
          "type": "integer"
        },
        "resolved_rate_evaluable": {
          "$ref": "#/$defs/ExplicitRate"
        },
        "resolved_rate_planned": {
          "$ref": "#/$defs/ExplicitRate"
        },
        "suite_release_identity": {
          "title": "Suite Release Identity",
          "type": "string"
        },
        "system_coverage_count": {
          "minimum": 0,
          "title": "System Coverage Count",
          "type": "integer"
        },
        "task_coverage_count": {
          "minimum": 0,
          "title": "Task Coverage Count",
          "type": "integer"
        },
        "valid_count": {
          "minimum": 0,
          "title": "Valid Count",
          "type": "integer"
        }
      },
      "required": [
        "partition_id",
        "suite_release_identity",
        "correctness_definition_hash",
        "planned_count",
        "valid_count",
        "evaluable_count",
        "resolved_count",
        "resolved_rate_evaluable",
        "resolved_rate_planned",
        "correctness_stages",
        "task_coverage_count",
        "system_coverage_count"
      ],
      "title": "CompatibilityAggregate",
      "type": "object"
    },
    "CostAccounting": {
