        "evaluable": {
          "minimum": 0,
          "title": "Evaluable",
          "type": "integer"
        },
        "infrastructure_failures": {
          "minimum": 0,
          "title": "Infrastructure Failures",
          "type": "integer"
        },
        "pass_at_1": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass At 1"
        },
        "pass_at_2": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass At 2"
        },
        "pass_at_3": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass At 3"
        },
        "planned": {
          "minimum": 0,
          "title": "Planned",
          "type": "integer"
        },
        "resolved": {
          "minimum": 0,
          "title": "Resolved",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "terminal": {
          "minimum": 0,
          "title": "Terminal",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "agent_version_id",
        "planned",
        "terminal",
        "evaluable",
        "resolved",
        "contained_policy_failures",
        "infrastructure_failures"
      ],
      "title": "TaskVersionMetric",
      "type": "object"
    },
    "VersionMetricSummary": {
