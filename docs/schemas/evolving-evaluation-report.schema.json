{
  "$defs": {
    "PairedVersionDifference": {
      "additionalProperties": false,
      "properties": {
        "baseline_version_id": {
          "title": "Baseline Version Id",
          "type": "string"
        },
        "evolved_version_id": {
          "title": "Evolved Version Id",
          "type": "string"
        },
        "macro_pass_at_1_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Macro Pass At 1 Delta"
        },
        "macro_pass_at_2_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Macro Pass At 2 Delta"
        },
        "macro_pass_at_3_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Macro Pass At 3 Delta"
        },
        "mean_tokens_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Tokens Delta"
        },
        "mean_wall_time_s_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Wall Time S Delta"
        },
        "policy_failure_rate_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Failure Rate Delta"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "baseline_version_id",
        "evolved_version_id"
      ],
      "title": "PairedVersionDifference",
      "type": "object"
    },
    "TaskVersionMetric": {
      "additionalProperties": false,
