  "$id": "https://verigym.dev/schemas/1.0/evolving-evaluation-report.schema.json",
  "additionalProperties": false,
  "properties": {
    "establishes_general_improvement": {
      "const": false,
      "default": false,
      "title": "Establishes General Improvement",
      "type": "boolean"
    },
    "heldout_plan_hash": {
      "title": "Heldout Plan Hash",
      "type": "string"
    },
    "heldout_task_count": {
      "minimum": 0,
      "title": "Heldout Task Count",
      "type": "integer"
    },
    "no_weight_update": {
      "const": true,
      "default": true,
      "title": "No Weight Update",
      "type": "boolean"
    },
    "paired_difference": {
      "$ref": "#/$defs/PairedVersionDifference"
    },
    "report_hash": {
      "title": "Report Hash",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "required_interpretation": {
      "const": "The before/after result is a bounded first-party Evolve-Context pilot and does not establish general performance improvement.",
      "default": "The before/after result is a bounded first-party Evolve-Context pilot and does not establish general performance improvement.",
      "title": "Required Interpretation",
      "type": "string"
    },
    "samples_per_task_version": {
      "minimum": 1,
      "title": "Samples Per Task Version",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split_manifest_hash": {
      "title": "Split Manifest Hash",
      "type": "string"
    },
    "task_version_metrics": {
      "items": {
        "$ref": "#/$defs/TaskVersionMetric"
      },
      "title": "Task Version Metrics",
      "type": "array"
    },
    "version_metrics": {
      "items": {
        "$ref": "#/$defs/VersionMetricSummary"
      },
      "title": "Version Metrics",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "split_manifest_hash",
    "heldout_plan_hash",
    "version_metrics",
    "task_version_metrics",
    "paired_difference",
    "heldout_task_count",
    "samples_per_task_version",
    "report_hash"
  ],
  "title": "EvolvingEvaluationReport",
  "type": "object"
}
