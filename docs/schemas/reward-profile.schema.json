{
  "$id": "https://verigym.dev/schemas/1.0/reward-profile.schema.json",
  "additionalProperties": false,
  "properties": {
    "outcome_values": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "resolved_candidate",
          "incorrect_policy_compliant_candidate",
          "contained_workspace_policy_failure",
          "strict_output_failure",
          "infrastructure_invalid",
          "cancelled_or_interrupted"
        ]
      },
      "title": "Outcome Values",
      "type": "object"
    },
    "profile_hash": {
      "title": "Profile Hash",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "universal_benchmark_score": {
      "const": false,
      "default": false,
      "title": "Universal Benchmark Score",
      "type": "boolean"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "outcome_values",
    "profile_hash"
  ],
  "title": "RewardProfile",
  "type": "object"
}
