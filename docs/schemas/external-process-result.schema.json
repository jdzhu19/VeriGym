{
  "$defs": {
    "ExternalProcessRuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "agent_executable_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Executable Name",
          "type": "string"
        },
        "agent_executable_sha256": {
          "title": "Agent Executable Sha256",
          "type": "string"
        },
        "agent_executable_version": {
          "title": "Agent Executable Version",
          "type": "string"
        },
        "agent_image_architecture": {
          "title": "Agent Image Architecture",
          "type": "string"
        },
        "agent_image_id": {
          "title": "Agent Image Id",
          "type": "string"
        },
        "agent_image_os": {
          "title": "Agent Image Os",
          "type": "string"
        },
        "agent_image_reference": {
          "title": "Agent Image Reference",
          "type": "string"
        },
        "agent_image_user": {
          "title": "Agent Image User",
          "type": "string"
        },
        "capability_fingerprint": {
          "title": "Capability Fingerprint",
          "type": "string"
        },
        "configuration_fingerprint": {
          "title": "Configuration Fingerprint",
          "type": "string"
        },
        "container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Id"
        },
        "exec_server_process_count": {
          "const": 1,
          "default": 1,
          "title": "Exec Server Process Count",
          "type": "integer"
        },
        "execution_backend": {
          "const": "docker_outer_runtime_delegated",
          "title": "Execution Backend",
          "type": "string"
        },
        "execution_owner": {
          "const": "verigym_runtime",
          "title": "Execution Owner",
          "type": "string"
        },
        "host_executable_name": {
          "title": "Host Executable Name",
          "type": "string"
        },
        "host_executable_sha256": {
          "title": "Host Executable Sha256",
          "type": "string"
        },
        "host_executable_version": {
          "title": "Host Executable Version",
          "type": "string"
        },
        "invocation_spec_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invocation Spec Hash"
        },
        "logical_workspace_root": {
          "const": "/workspace",
          "title": "Logical Workspace Root",
          "type": "string"
        },
        "model_process_count": {
          "const": 1,
          "default": 1,
          "title": "Model Process Count",
          "type": "integer"
        },
        "payload_binding_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Binding Hash"
        },
        "prompt_policy_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Policy Hash"
        },
        "prompt_text_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Text Sha256"
        },
        "protocol": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "title": "Protocol",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "verifier_image_id": {
          "title": "Verifier Image Id",
          "type": "string"
        }
      },
      "required": [
        "execution_owner",
        "execution_backend",
        "protocol",
        "verifier_image_id",
        "agent_image_id",
        "agent_image_reference",
        "agent_image_os",
        "agent_image_architecture",
        "agent_image_user",
        "agent_executable_name",
        "agent_executable_sha256",
        "agent_executable_version",
        "host_executable_name",
        "host_executable_sha256",
        "host_executable_version",
        "capability_fingerprint",
        "configuration_fingerprint",
        "logical_workspace_root"
      ],
      "title": "ExternalProcessRuntimeIdentity",
      "type": "object"
    },
    "ExternalProcessSecurityEvidence": {
      "additionalProperties": false,
      "properties": {
        "api_key_environment_forwarded": {
          "const": false,
          "title": "Api Key Environment Forwarded",
          "type": "boolean"
        },
        "boundary": {
          "const": "docker_outer_runtime",
          "title": "Boundary",
          "type": "string"
        },
        "broker_listen_scope": {
          "const": "127.0.0.1",
          "title": "Broker Listen Scope",
          "type": "string"
        },
        "broker_stopped": {
          "title": "Broker Stopped",
          "type": "boolean"
        },
        "broker_transport": {
          "const": "loopback_websocket_to_container_stdio",
          "title": "Broker Transport",
          "type": "string"
        },
        "cap_drop": {
          "items": {
            "const": "ALL",
            "type": "string"
          },
          "title": "Cap Drop",
          "type": "array"
        },
        "cleanup_verified": {
          "title": "Cleanup Verified",
          "type": "boolean"
        },
        "container_exit_inspected": {
          "title": "Container Exit Inspected",
          "type": "boolean"
        },
        "container_removed": {
          "title": "Container Removed",
          "type": "boolean"
        },
        "control_plane_forwarded_proxy_environment_names": {
          "items": {
            "enum": [
              "HTTP_PROXY",
              "HTTPS_PROXY"
            ],
            "type": "string"
          },
          "title": "Control Plane Forwarded Proxy Environment Names",
          "type": "array"
        },
        "control_plane_mandatory_loopback_bypass_present": {
          "default": true,
          "title": "Control Plane Mandatory Loopback Bypass Present",
          "type": "boolean"
        },
        "control_plane_proxy_forwarding_enabled": {
          "default": false,
          "title": "Control Plane Proxy Forwarding Enabled",
          "type": "boolean"
        },
        "control_plane_synthesized_environment_names": {
          "items": {
            "enum": [
              "NO_PROXY",
              "no_proxy"
            ],
            "type": "string"
          },
          "title": "Control Plane Synthesized Environment Names",
          "type": "array"
        },
        "cpus": {
          "exclusiveMinimum": 0.0,
          "title": "Cpus",
          "type": "number"
        },
        "credential_contents_accessed_by_verigym": {
          "const": false,
          "title": "Credential Contents Accessed By Verigym",
          "type": "boolean"
        },
        "credential_environment_names_in_container": {
          "items": {
            "type": "string"
          },
          "title": "Credential Environment Names In Container",
          "type": "array"
        },
        "credential_files_mounted": {
          "const": false,
          "title": "Credential Files Mounted",
          "type": "boolean"
        },
        "docker_socket_mounted": {
          "const": false,
          "title": "Docker Socket Mounted",
          "type": "boolean"
        },
        "effective_controls_verified": {
          "title": "Effective Controls Verified",
          "type": "boolean"
        },
        "effective_timeout_s": {
          "exclusiveMinimum": 0.0,
          "title": "Effective Timeout S",
          "type": "number"
        },
        "environment_names": {
          "items": {
            "type": "string"
          },
          "title": "Environment Names",
          "type": "array"
        },
        "hidden_verifier_mounted": {
          "const": false,
          "title": "Hidden Verifier Mounted",
          "type": "boolean"
        },
        "host_home_mounted": {
          "const": false,
          "title": "Host Home Mounted",
          "type": "boolean"
        },
        "init": {
          "const": true,
          "title": "Init",
          "type": "boolean"
        },
        "memory_bytes": {
          "minimum": 1,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "mount_destinations": {
          "items": {
            "enum": [
              "/verigym-public",
              "/workspace"
            ],
            "type": "string"
          },
          "title": "Mount Destinations",
          "type": "array"
        },
        "network_mode": {
          "const": "none",
          "title": "Network Mode",
          "type": "string"
        },
        "no_new_privileges": {
          "const": true,
          "title": "No New Privileges",
          "type": "boolean"
        },
        "non_root": {
          "const": true,
          "title": "Non Root",
          "type": "boolean"
        },
        "output_limit_bytes": {
          "minimum": 1,
          "title": "Output Limit Bytes",
          "type": "integer"
        },
        "pids_limit": {
          "minimum": 1,
          "title": "Pids Limit",
          "type": "integer"
        },
        "private_ipc_namespace": {
          "const": true,
          "title": "Private Ipc Namespace",
          "type": "boolean"
        },
        "private_pid_namespace": {
          "const": true,
          "title": "Private Pid Namespace",
          "type": "boolean"
        },
        "process_group_cleaned": {
          "title": "Process Group Cleaned",
          "type": "boolean"
        },
        "provider_network_in_container": {
          "const": false,
          "title": "Provider Network In Container",
          "type": "boolean"
        },
        "proxy_environment_names_in_container": {
          "items": {
            "type": "string"
          },
          "title": "Proxy Environment Names In Container",
          "type": "array"
        },
        "public_test_assets_mounted_read_only": {
          "default": false,
          "title": "Public Test Assets Mounted Read Only",
          "type": "boolean"
        },
        "read_only_destinations": {
          "items": {
            "const": "/verigym-public",
            "type": "string"
          },
          "title": "Read Only Destinations",
          "type": "array"
        },
        "read_only_rootfs": {
          "const": true,
          "title": "Read Only Rootfs",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_repository_mounted": {
          "const": false,
          "title": "Source Repository Mounted",
          "type": "boolean"
        },
        "tmpfs_bytes": {
          "minimum": 1,
          "title": "Tmpfs Bytes",
          "type": "integer"
        },
        "user_config_contents_accessed_by_verigym": {
          "const": false,
          "title": "User Config Contents Accessed By Verigym",
          "type": "boolean"
        },
        "user_config_metadata_unchanged": {
          "title": "User Config Metadata Unchanged",
          "type": "boolean"
        },
        "workspace_changed_paths": {
          "items": {
            "type": "string"
          },
          "title": "Workspace Changed Paths",
          "type": "array"
        },
        "workspace_empty_after": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Empty After"
        },
        "workspace_empty_before": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Empty Before"
        },
        "writable_destinations": {
          "items": {
            "enum": [
              "/workspace",
              "/tmp"
            ],
            "type": "string"
          },
          "title": "Writable Destinations",
          "type": "array"
        }
      },
      "required": [
        "boundary",
        "network_mode",
        "read_only_rootfs",
        "non_root",
        "cap_drop",
        "no_new_privileges",
        "init",
        "private_pid_namespace",
        "private_ipc_namespace",
        "mount_destinations",
        "writable_destinations",
        "environment_names",
        "credential_environment_names_in_container",
        "proxy_environment_names_in_container",
        "host_home_mounted",
        "source_repository_mounted",
        "hidden_verifier_mounted",
        "docker_socket_mounted",
        "credential_files_mounted",
        "api_key_environment_forwarded",
        "credential_contents_accessed_by_verigym",
        "user_config_contents_accessed_by_verigym",
        "user_config_metadata_unchanged",
        "provider_network_in_container",
        "broker_transport",
        "broker_listen_scope",
        "effective_controls_verified",
        "container_exit_inspected",
        "cleanup_verified",
        "container_removed",
        "broker_stopped",
        "process_group_cleaned",
        "memory_bytes",
        "cpus",
        "pids_limit",
        "tmpfs_bytes",
        "output_limit_bytes",
        "effective_timeout_s"
      ],
      "title": "ExternalProcessSecurityEvidence",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/external-process-result.schema.json",
  "additionalProperties": false,
  "properties": {
    "cleanup_complete": {
      "title": "Cleanup Complete",
      "type": "boolean"
    },
    "duration_s": {
      "minimum": 0.0,
      "title": "Duration S",
      "type": "number"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exit Code"
    },
    "failure_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Category"
    },
    "failure_kind": {
      "anyOf": [
        {
          "const": "infrastructure",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Kind"
    },
    "failure_origin": {
      "anyOf": [
        {
          "enum": [
            "host_control_plane",
            "agent_container",
            "broker",
            "external_provider"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Origin"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "oom_killed": {
      "title": "Oom Killed",
      "type": "boolean"
    },
    "output_limit_hit": {
      "title": "Output Limit Hit",
      "type": "boolean"
    },
    "process_group_cleaned": {
      "title": "Process Group Cleaned",
      "type": "boolean"
    },
    "runtime_identity": {
      "$ref": "#/$defs/ExternalProcessRuntimeIdentity"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "security": {
      "$ref": "#/$defs/ExternalProcessSecurityEvidence"
    },
    "stderr": {
      "title": "Stderr",
      "type": "string"
    },
    "stderr_truncated": {
      "title": "Stderr Truncated",
      "type": "boolean"
    },
    "stdout": {
      "title": "Stdout",
      "type": "string"
    },
    "stdout_truncated": {
      "title": "Stdout Truncated",
      "type": "boolean"
    },
    "terminal_event_seen": {
      "title": "Terminal Event Seen",
      "type": "boolean"
    },
    "timed_out": {
      "title": "Timed Out",
      "type": "boolean"
    }
  },
  "required": [
    "exit_code",
    "stdout",
    "stderr",
    "duration_s",
    "timed_out",
    "stdout_truncated",
    "stderr_truncated",
    "output_limit_hit",
    "oom_killed",
    "process_group_cleaned",
    "cleanup_complete",
    "terminal_event_seen",
    "runtime_identity",
    "security"
  ],
  "title": "ExternalProcessResult",
  "type": "object"
}
