{
  "$defs": {
    "ContaminationMatch": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "title": "Evidence Hash",
          "type": "string"
        },
        "heldout_identity": {
          "title": "Heldout Identity",
          "type": "string"
        },
        "match_class": {
          "enum": [
            "task_identity_overlap",
            "source_identity_overlap",
            "exact_file_content",
            "issue_text_duplication",
            "source_code_sequence",
            "hidden_test_fragment",
            "reference_patch_fragment",
            "exact_task_id",
            "repository_path",
            "distinctive_identifier",
            "heldout_issue_phrase",
            "allowed_synthesis_vocabulary",
            "generic_vocabulary"
          ],
          "title": "Match Class",
          "type": "string"
        },
        "match_location_class": {
          "title": "Match Location Class",
          "type": "string"
        },
        "normalized_token_count": {
          "minimum": 1,
          "title": "Normalized Token Count",
          "type": "integer"
        },
        "public_excerpt": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Excerpt"
        },
        "raw_private_content_exported": {
          "const": false,
          "default": false,
          "title": "Raw Private Content Exported",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "hard_contamination",
            "diagnostic_overlap"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_artifact_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Artifact Hash"
        },
        "stage": {
          "enum": [
            "split_asset",
            "frozen_memory_to_heldout"
          ],
          "title": "Stage",
          "type": "string"
        },
        "task_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Hash"
        },
        "training_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Identity"
        }
      },
      "required": [
        "stage",
        "match_class",
        "severity",
        "evidence_hash",
        "heldout_identity",
        "normalized_token_count",
        "match_location_class"
      ],
      "title": "ContaminationMatch",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/split-asset-contamination-scan.schema.json",
  "additionalProperties": false,
  "properties": {
    "diagnostic_overlap_count": {
      "const": 0,
      "default": 0,
      "title": "Diagnostic Overlap Count",
      "type": "integer"
    },
    "hard_contamination_count": {
      "minimum": 0,
      "title": "Hard Contamination Count",
      "type": "integer"
    },
    "hidden_assets_exported": {
      "const": false,
      "default": false,
      "title": "Hidden Assets Exported",
      "type": "boolean"
    },
    "implementation_error": {
      "default": false,
      "title": "Implementation Error",
      "type": "boolean"
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/ContaminationMatch"
      },
      "title": "Matches",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "policy_hash": {
      "title": "Policy Hash",
      "type": "string"
    },
    "reference_assets_exported": {
      "const": false,
      "default": false,
      "title": "Reference Assets Exported",
      "type": "boolean"
    },
    "scan_hash": {
      "title": "Scan Hash",
      "type": "string"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_manifest_hash": {
      "title": "Signature Manifest Hash",
      "type": "string"
    },
    "split_manifest_hash": {
      "title": "Split Manifest Hash",
      "type": "string"
    }
  },
  "required": [
    "scan_id",
    "split_manifest_hash",
    "policy_hash",
    "signature_manifest_hash",
    "matches",
    "hard_contamination_count",
    "passed",
    "scan_hash"
  ],
  "title": "SplitAssetContaminationScan",
  "type": "object"
}
