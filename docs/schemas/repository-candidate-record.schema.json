{
  "$defs": {
    "RepositoryFileIdentity": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "RepositoryFileIdentity",
      "type": "object"
    },
    "RepositoryPatchSummary": {
      "additionalProperties": false,
      "properties": {
        "added_files": {
          "items": {
            "type": "string"
          },
          "title": "Added Files",
          "type": "array"
        },
        "added_lines": {
          "minimum": 0,
          "title": "Added Lines",
          "type": "integer"
        },
        "base_repository_hash": {
          "title": "Base Repository Hash",
          "type": "string"
        },
        "binary_files": {
          "items": {
            "type": "string"
          },
          "title": "Binary Files",
          "type": "array"
        },
        "candidate_repository_hash": {
          "title": "Candidate Repository Hash",
          "type": "string"
        },
        "changed_files": {
          "items": {
            "type": "string"
          },
          "title": "Changed Files",
          "type": "array"
        },
        "created_file_count": {
          "minimum": 0,
          "title": "Created File Count",
          "type": "integer"
        },
        "deleted_file_count": {
          "minimum": 0,
          "title": "Deleted File Count",
          "type": "integer"
        },
        "deleted_files": {
          "items": {
            "type": "string"
          },
          "title": "Deleted Files",
          "type": "array"
        },
        "deleted_lines": {
          "minimum": 0,
          "title": "Deleted Lines",
          "type": "integer"
        },
        "mode_changed_files": {
          "items": {
            "type": "string"
          },
          "title": "Mode Changed Files",
          "type": "array"
        },
        "patch_hash": {
          "title": "Patch Hash",
          "type": "string"
        },
        "policy_status": {
          "const": "passed",
          "title": "Policy Status",
          "type": "string"
        },
        "reapplied_repository_hash": {
          "title": "Reapplied Repository Hash",
          "type": "string"
        },
        "reapply_exact": {
          "const": true,
          "title": "Reapply Exact",
          "type": "boolean"
        },
        "renamed_files": {
          "items": {
            "type": "string"
          },
          "title": "Renamed Files",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "patch_hash",
        "base_repository_hash",
        "candidate_repository_hash",
        "reapplied_repository_hash",
        "reapply_exact",
        "changed_files",
        "created_file_count",
        "deleted_file_count",
        "added_lines",
        "deleted_lines",
        "policy_status"
      ],
      "title": "RepositoryPatchSummary",
      "type": "object"
    },
    "RepositorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/RepositoryFileIdentity"
          },
          "title": "Files",
          "type": "array"
        },
        "repository_hash": {
          "title": "Repository Hash",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "total_bytes": {
          "minimum": 0,
          "title": "Total Bytes",
          "type": "integer"
        }
      },
      "required": [
        "repository_hash",
        "total_bytes",
        "files"
      ],
      "title": "RepositorySnapshot",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/repository-candidate-record.schema.json",
  "additionalProperties": false,
  "properties": {
    "base": {
      "$ref": "#/$defs/RepositorySnapshot"
    },
    "candidate": {
      "$ref": "#/$defs/RepositorySnapshot"
    },
    "hidden_assets_present": {
      "const": false,
      "title": "Hidden Assets Present",
      "type": "boolean"
    },
    "patch": {
      "$ref": "#/$defs/RepositoryPatchSummary"
    },
    "public_test_ids": {
      "items": {
        "type": "string"
      },
      "title": "Public Test Ids",
      "type": "array"
    },
    "reference_patch_used": {
      "const": false,
      "title": "Reference Patch Used",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "base",
    "candidate",
    "patch",
    "public_test_ids",
    "hidden_assets_present",
    "reference_patch_used"
  ],
  "title": "RepositoryCandidateRecord",
  "type": "object"
}
