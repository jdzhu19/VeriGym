{
  "$defs": {
    "RuntimeBackendInfo": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Version"
        },
        "backend_type": {
          "title": "Backend Type",
          "type": "string"
        },
        "client_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Version"
        },
        "cpu_limit_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Limit Supported"
        },
        "memory_limit_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Limit Supported"
        },
        "pids_limit_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids Limit Supported"
        },
        "rootless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rootless"
        },
        "server_architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Architecture"
        },
        "server_os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Os"
        },
        "server_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Version"
        },
        "swap_limit_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Swap Limit Supported"
        }
      },
      "required": [
        "backend_type"
      ],
      "title": "RuntimeBackendInfo",
      "type": "object"
    },
    "RuntimeCleanupSummary": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "default": false,
          "title": "Complete",
          "type": "boolean"
        },
        "removed_container_ids": {
          "items": {
            "type": "string"
          },
          "title": "Removed Container Ids",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "RuntimeCleanupSummary",
      "type": "object"
    },
    "RuntimeImageIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "title": "Architecture",
          "type": "string"
        },
        "compatibility_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compatibility Status"
        },
        "configured_image_user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configured Image User"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "effective_user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective User"
        },
        "iverilog_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iverilog Version"
        },
        "observed_gid": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Gid"
        },
        "observed_uid": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Uid"
        },
        "os": {
          "title": "Os",
          "type": "string"
        },
        "repository_digests": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Digests"
        },
        "requested_reference": {
          "title": "Requested Reference",
          "type": "string"
        },
        "resolved_image_id": {
          "title": "Resolved Image Id",
          "type": "string"
        },
        "vvp_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vvp Version"
        }
      },
      "required": [
        "requested_reference",
        "resolved_image_id",
        "os",
        "architecture"
      ],
      "title": "RuntimeImageIdentity",
      "type": "object"
    },
    "RuntimeResourceSummary": {
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "exclusiveMinimum": 0.0,
          "title": "Cpus",
          "type": "number"
        },
        "max_artifact_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Artifact Bytes"
        },
        "max_artifact_file_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Artifact File Bytes"
        },
        "max_command_time_s": {
          "minimum": 1,
          "title": "Max Command Time S",
          "type": "integer"
        },
        "max_output_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Bytes"
        },
        "memory_bytes": {
          "minimum": 1,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "memory_swap_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Swap Bytes"
        },
        "pids_limit": {
          "minimum": 1,
          "title": "Pids Limit",
          "type": "integer"
        },
        "stop_timeout_s": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Timeout S"
        },
        "swap_enforced": {
          "title": "Swap Enforced",
          "type": "boolean"
        },
        "tmpfs_bytes": {
          "minimum": 1,
          "title": "Tmpfs Bytes",
          "type": "integer"
        }
      },
      "required": [
        "memory_bytes",
        "swap_enforced",
        "cpus",
        "pids_limit",
        "tmpfs_bytes",
        "max_command_time_s"
      ],
      "title": "RuntimeResourceSummary",
      "type": "object"
    },
    "RuntimeSecuritySummary": {
      "additionalProperties": false,
      "properties": {
        "cap_drop": {
          "items": {
            "type": "string"
          },
          "title": "Cap Drop",
          "type": "array"
        },
        "configured_user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configured User"
        },
        "docker_socket_mounted": {
          "default": false,
          "title": "Docker Socket Mounted",
          "type": "boolean"
        },
        "environment_names": {
          "items": {
            "type": "string"
          },
          "title": "Environment Names",
          "type": "array"
        },
        "host_home_mounted": {
          "default": false,
          "title": "Host Home Mounted",
          "type": "boolean"
        },
        "init": {
          "default": false,
          "title": "Init",
          "type": "boolean"
        },
        "mount_destinations": {
          "items": {
            "type": "string"
          },
          "title": "Mount Destinations",
          "type": "array"
        },
        "network_mode": {
          "title": "Network Mode",
          "type": "string"
        },
        "no_new_privileges": {
          "default": false,
          "title": "No New Privileges",
          "type": "boolean"
        },
        "observed_gid": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Gid"
        },
        "observed_uid": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Uid"
        },
        "privileged": {
          "default": false,
          "title": "Privileged",
          "type": "boolean"
        },
        "read_only_rootfs": {
          "title": "Read Only Rootfs",
          "type": "boolean"
        },
        "writable_destinations": {
          "items": {
            "type": "string"
          },
          "title": "Writable Destinations",
          "type": "array"
        }
      },
      "required": [
        "network_mode",
        "read_only_rootfs"
      ],
      "title": "RuntimeSecuritySummary",
      "type": "object"
    },
    "RuntimeSessionRecord": {
      "additionalProperties": false,
      "properties": {
        "cleanup_complete": {
          "default": false,
          "title": "Cleanup Complete",
          "type": "boolean"
        },
        "cleanup_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Cleanup Warnings",
          "type": "array"
        },
        "command_count": {
          "default": 0,
          "minimum": 0,
          "title": "Command Count",
          "type": "integer"
        },
        "container_ids": {
          "items": {
            "type": "string"
          },
          "title": "Container Ids",
          "type": "array"
        },
        "frozen": {
          "default": false,
          "title": "Frozen",
          "type": "boolean"
        },
        "resolved_image_id": {
          "title": "Resolved Image Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "role",
        "resolved_image_id"
      ],
      "title": "RuntimeSessionRecord",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/runtime-descriptor.schema.json",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "default": "1.0",
      "title": "Api Version",
      "type": "string"
    },
    "backend": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeBackendInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "cleanup": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeCleanupSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "configuration_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Fingerprint"
    },
    "deterministic": {
      "default": true,
      "title": "Deterministic",
      "type": "boolean"
    },
    "image": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeImageIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "isolation_level": {
      "title": "Isolation Level",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "resources": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeResourceSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "security": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeSecuritySummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/RuntimeSessionRecord"
      },
      "title": "Sessions",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "provider",
    "isolation_level"
  ],
  "title": "RuntimeDescriptor",
  "type": "object"
}
