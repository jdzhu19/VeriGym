{
  "$defs": {
    "ContaminationFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "task_id_overlap",
            "source_hash_overlap",
            "identical_file",
            "reference_fragment",
            "hidden_test_fragment",
            "issue_text_overlap",
            "memory_heldout_token"
          ],
          "title": "Category",
          "type": "string"
        },
        "evidence_hash": {
          "title": "Evidence Hash",
          "type": "string"
        },
        "heldout_identity": {
          "title": "Heldout Identity",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "training_identity": {
          "title": "Training Identity",
          "type": "string"
        }
      },
      "required": [
        "category",
        "training_identity",
        "heldout_identity",
        "evidence_hash"
      ],
      "title": "ContaminationFinding",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/contamination-scan.schema.json",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/ContaminationFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "heldout_file_count": {
      "minimum": 0,
      "title": "Heldout File Count",
      "type": "integer"
    },
    "hidden_assets_exported": {
      "const": false,
      "default": false,
      "title": "Hidden Assets Exported",
      "type": "boolean"
    },
    "memory_pack_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Pack Hash"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "reference_assets_exported": {
      "const": false,
      "default": false,
      "title": "Reference Assets Exported",
      "type": "boolean"
    },
    "scan_hash": {
      "title": "Scan Hash",
      "type": "string"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split_manifest_hash": {
      "title": "Split Manifest Hash",
      "type": "string"
    },
    "train_file_count": {
      "minimum": 0,
      "title": "Train File Count",
      "type": "integer"
    }
  },
  "required": [
    "scan_id",
    "split_manifest_hash",
    "findings",
    "passed",
    "train_file_count",
    "heldout_file_count",
    "scan_hash"
  ],
  "title": "ContaminationScan",
  "type": "object"
}
