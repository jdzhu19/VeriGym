{
  "$defs": {
    "RewardVector": {
      "additionalProperties": false,
      "properties": {
        "added_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Added Lines"
        },
        "candidate_compile_passed": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Compile Passed"
        },
        "changed_file_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed File Count"
        },
        "deleted_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deleted Lines"
        },
        "hidden_regression_passed": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hidden Regression Passed"
        },
        "infrastructure_valid": {
          "enum": [
            0,
            1
          ],
          "title": "Infrastructure Valid",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "outcome_kind": {
          "enum": [
            "resolved_candidate",
            "incorrect_policy_compliant_candidate",
            "contained_workspace_policy_failure",
            "strict_output_failure",
            "infrastructure_invalid",
            "cancelled_or_interrupted"
          ],
          "title": "Outcome Kind",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "patch_reproducible": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Patch Reproducible"
        },
        "policy_compliance": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy Compliance"
        },
        "public_test_passed": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Public Test Passed"
        },
        "public_test_reached": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Public Test Reached"
        },
        "public_tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Tool Calls"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_resolved": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Resolved"
        },
        "wall_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Time S"
        }
      },
      "required": [
        "outcome_kind",
        "infrastructure_valid",
        "policy_compliance",
        "public_test_reached",
        "public_test_passed",
        "patch_reproducible",
        "candidate_compile_passed",
        "hidden_regression_passed",
        "task_resolved"
      ],
      "title": "RewardVector",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/reward-derivation-record.schema.json",
  "additionalProperties": false,
  "properties": {
    "external_calls": {
      "const": 0,
      "default": 0,
      "title": "External Calls",
      "type": "integer"
    },
    "offline_recomputed": {
      "const": true,
      "default": true,
      "title": "Offline Recomputed",
      "type": "boolean"
    },
    "reward": {
      "$ref": "#/$defs/RewardVector"
    },
    "reward_hash": {
      "title": "Reward Hash",
      "type": "string"
    },
    "reward_schema_id": {
      "const": "repo_rtl_reward_vector_v1",
      "default": "repo_rtl_reward_vector_v1",
      "title": "Reward Schema Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scalar_profile_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scalar Profile Hash"
    },
    "scalar_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scalar Profile Id"
    },
    "scalar_reward": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scalar Reward"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_artifact_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Artifact Hashes",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "source_artifact_hashes",
    "reward",
    "reward_hash"
  ],
  "title": "RewardDerivationRecord",
  "type": "object"
}
