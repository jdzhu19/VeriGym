{
  "$defs": {
    "RewardVector": {
      "additionalProperties": false,
      "properties": {
        "added_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Added Lines"
        },
        "candidate_compile_passed": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Compile Passed"
        },
        "changed_file_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed File Count"
        },
        "deleted_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deleted Lines"
        },
        "hidden_regression_passed": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hidden Regression Passed"
        },
        "infrastructure_valid": {
          "enum": [
            0,
            1
          ],
          "title": "Infrastructure Valid",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "outcome_kind": {
          "enum": [
            "resolved_candidate",
            "incorrect_policy_compliant_candidate",
            "contained_workspace_policy_failure",
            "strict_output_failure",
            "infrastructure_invalid",
            "cancelled_or_interrupted"
          ],
          "title": "Outcome Kind",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "patch_reproducible": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Patch Reproducible"
        },
        "policy_compliance": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy Compliance"
        },
        "public_test_passed": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Public Test Passed"
        },
        "public_test_reached": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Public Test Reached"
        },
        "public_tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Tool Calls"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_resolved": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Resolved"
        },
        "wall_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Time S"
        }
      },
      "required": [
        "outcome_kind",
        "infrastructure_valid",
        "policy_compliance",
        "public_test_reached",
        "public_test_passed",
        "patch_reproducible",
        "candidate_compile_passed",
        "hidden_regression_passed",
        "task_resolved"
      ],
      "title": "RewardVector",
      "type": "object"
    },
    "SanitizedTrainingEpisode": {
      "additionalProperties": false,
      "properties": {
        "compile_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compile Passed"
        },
        "generalized_failure_labels": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Generalized Failure Labels",
          "type": "array"
        },
        "hidden_regression_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hidden Regression Passed"
        },
        "observable_action_summary": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Observable Action Summary",
          "type": "array"
        },
        "outcome_kind": {
          "enum": [
            "resolved_candidate",
            "incorrect_policy_compliant_candidate",
            "contained_workspace_policy_failure",
            "strict_output_failure",
            "infrastructure_invalid",
            "cancelled_or_interrupted"
          ],
          "title": "Outcome Kind",
          "type": "string"
        },
        "patch_metrics": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Patch Metrics",
          "type": "object"
        },
        "public_task_category": {
          "title": "Public Task Category",
          "type": "string"
        },
        "public_test_outcomes": {
          "items": {
            "type": "boolean"
          },
          "maxItems": 64,
          "title": "Public Test Outcomes",
          "type": "array"
        },
        "reward": {
          "$ref": "#/$defs/RewardVector"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "public_task_category",
        "observable_action_summary",
        "public_test_outcomes",
        "patch_metrics",
        "outcome_kind",
        "reward",
        "generalized_failure_labels"
      ],
      "title": "SanitizedTrainingEpisode",
      "type": "object"
    },
    "SanitizedTrainingSummary": {
      "additionalProperties": false,
      "properties": {
        "episodes": {
          "items": {
            "$ref": "#/$defs/SanitizedTrainingEpisode"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Episodes",
          "type": "array"
        },
        "heldout_assets_included": {
          "const": false,
          "default": false,
          "title": "Heldout Assets Included",
          "type": "boolean"
        },
        "hidden_assets_included": {
          "const": false,
          "default": false,
          "title": "Hidden Assets Included",
          "type": "boolean"
        },
        "private_reasoning_included": {
          "const": false,
          "default": false,
          "title": "Private Reasoning Included",
          "type": "boolean"
        },
        "references_included": {
          "const": false,
          "default": false,
          "title": "References Included",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "split_manifest_hash": {
          "title": "Split Manifest Hash",
          "type": "string"
        },
        "summary_hash": {
          "title": "Summary Hash",
          "type": "string"
        },
        "summary_id": {
          "title": "Summary Id",
          "type": "string"
        },
        "trajectory_dataset_hash": {
          "title": "Trajectory Dataset Hash",
          "type": "string"
        }
      },
      "required": [
        "summary_id",
        "split_manifest_hash",
        "trajectory_dataset_hash",
        "episodes",
        "summary_hash"
      ],
      "title": "SanitizedTrainingSummary",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/memory-builder-input.schema.json",
  "additionalProperties": false,
  "properties": {
    "auth_semantic_id": {
      "title": "Auth Semantic Id",
      "type": "string"
    },
    "build_id": {
      "title": "Build Id",
      "type": "string"
    },
    "codex_identity_hash": {
      "title": "Codex Identity Hash",
      "type": "string"
    },
    "heldout_assets_available": {
      "const": false,
      "default": false,
      "title": "Heldout Assets Available",
      "type": "boolean"
    },
    "image_identity_hash": {
      "title": "Image Identity Hash",
      "type": "string"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "max_output_bytes": {
      "maximum": 262144,
      "minimum": 1,
      "title": "Max Output Bytes",
      "type": "integer"
    },
    "model_identity_hash": {
      "title": "Model Identity Hash",
      "type": "string"
    },
    "output_schema_hash": {
      "title": "Output Schema Hash",
      "type": "string"
    },
    "private_reasoning_requested": {
      "const": false,
      "default": false,
      "title": "Private Reasoning Requested",
      "type": "boolean"
    },
    "prompt_contract_hash": {
      "title": "Prompt Contract Hash",
      "type": "string"
    },
    "reasoning_effort": {
      "title": "Reasoning Effort",
      "type": "string"
    },
    "requested_model_id": {
      "title": "Requested Model Id",
      "type": "string"
    },
    "runtime_identity_hash": {
      "title": "Runtime Identity Hash",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "timeout_s": {
      "maximum": 300,
      "minimum": 1,
      "title": "Timeout S",
      "type": "integer"
    },
    "training_summary": {
      "$ref": "#/$defs/SanitizedTrainingSummary"
    }
  },
  "required": [
    "build_id",
    "training_summary",
    "prompt_contract_hash",
    "output_schema_hash",
    "model_identity_hash",
    "codex_identity_hash",
    "auth_semantic_id",
    "runtime_identity_hash",
    "image_identity_hash",
    "requested_model_id",
    "reasoning_effort",
    "timeout_s",
    "max_output_bytes",
    "input_hash"
  ],
  "title": "MemoryBuilderInput",
  "type": "object"
}
