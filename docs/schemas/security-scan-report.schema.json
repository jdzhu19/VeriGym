{
  "$defs": {
    "ArtifactSecurityScan": {
      "additionalProperties": false,
      "properties": {
        "artifact_content_class": {
          "enum": [
            "runtime_artifact",
            "trajectory_dataset",
            "memory_pack",
            "allowed_synthesis_corpus",
            "schema_or_contract",
            "documentation",
            "security_scan_fixture",
            "binary_build_artifact",
            "unknown"
          ],
          "title": "Artifact Content Class",
          "type": "string"
        },
        "diagnostic_security_vocabulary_count": {
          "minimum": 0,
          "title": "Diagnostic Security Vocabulary Count",
          "type": "integer"
        },
        "fields_examined": {
          "minimum": 0,
          "title": "Fields Examined",
          "type": "integer"
        },
        "hard_secret_leak_count": {
          "minimum": 0,
          "title": "Hard Secret Leak Count",
          "type": "integer"
        },
        "parser": {
          "enum": [
            "json",
            "jsonl",
            "yaml",
            "toml",
            "csv",
            "markdown",
            "text",
            "binary"
          ],
          "title": "Parser",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "scan_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scan Hash",
          "type": "string"
        },
        "scanner_error_count": {
          "minimum": 0,
          "title": "Scanner Error Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "structured": {
          "title": "Structured",
          "type": "boolean"
        }
      },
      "required": [
        "relative_path",
        "artifact_content_class",
        "parser",
        "size_bytes",
        "structured",
        "fields_examined",
        "hard_secret_leak_count",
        "diagnostic_security_vocabulary_count",
        "scanner_error_count",
        "scan_hash"
      ],
      "title": "ArtifactSecurityScan",
      "type": "object"
    },
    "SecurityFinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_content_class": {
          "enum": [
            "runtime_artifact",
            "trajectory_dataset",
            "memory_pack",
            "allowed_synthesis_corpus",
            "schema_or_contract",
            "documentation",
            "security_scan_fixture",
            "binary_build_artifact",
            "unknown"
          ],
          "title": "Artifact Content Class",
          "type": "string"
        },
        "evidence_category": {
          "enum": [
            "authorization_bearer",
            "provider_api_token",
            "session_or_cookie",
            "private_key",
            "credential_bearing_uri",
            "persisted_secret_assignment",
            "unknown_sensitive_high_entropy",
            "persisted_proxy_value",
            "raw_host_path",
            "diagnostic_security_metadata",
            "conceptual_security_vocabulary",
            "malformed_structured_artifact",
            "unsafe_filesystem_entry",
            "unsupported_or_oversized_artifact"
          ],
          "title": "Evidence Category",
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "field_role": {
          "enum": [
            "field_name",
            "environment_variable_name",
            "authentication_mode",
            "execution_boundary_enum",
            "boolean_policy",
            "null_policy",
            "known_hash_or_digest",
            "known_identifier",
            "normalized_base_url",
            "enum_or_identifier",
            "boolean_or_null_policy",
            "known_hash_identity",
            "known_path_identity",
            "documentation_text",
            "runtime_value",
            "credential_value_candidate",
            "unknown_value"
          ],
          "title": "Field Role",
          "type": "string"
        },
        "rationale_code": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Rationale Code",
          "type": "string"
        },
        "recoverable_fragment_exported": {
          "const": false,
          "default": false,
          "title": "Recoverable Fragment Exported",
          "type": "boolean"
        },
        "redacted": {
          "const": true,
          "default": true,
          "title": "Redacted",
          "type": "boolean"
        },
        "relative_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "hard_secret_leak",
            "diagnostic_security_metadata",
            "diagnostic_security_vocabulary",
            "scanner_error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "structured_field_path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structured Field Path"
        },
        "value_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Length"
        }
      },
      "required": [
        "relative_path",
        "artifact_content_class",
        "field_role",
        "evidence_category",
        "severity",
        "rationale_code"
      ],
      "title": "SecurityFinding",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/security-scan-report.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactSecurityScan"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "binary_files": {
      "minimum": 0,
      "title": "Binary Files",
      "type": "integer"
    },
    "diagnostic_security_vocabulary_count": {
      "minimum": 0,
      "title": "Diagnostic Security Vocabulary Count",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/SecurityFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "gate": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Gate",
      "type": "string"
    },
    "hard_secret_leak_count": {
      "minimum": 0,
      "title": "Hard Secret Leak Count",
      "type": "integer"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "proxy_values_persisted_or_hashed": {
      "const": false,
      "default": false,
      "title": "Proxy Values Persisted Or Hashed",
      "type": "boolean"
    },
    "raw_suspected_values_exported": {
      "const": false,
      "default": false,
      "title": "Raw Suspected Values Exported",
      "type": "boolean"
    },
    "report_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Hash",
      "type": "string"
    },
    "report_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "root_count": {
      "minimum": 1,
      "title": "Root Count",
      "type": "integer"
    },
    "scanned_bytes": {
      "minimum": 0,
      "title": "Scanned Bytes",
      "type": "integer"
    },
    "scanned_files": {
      "minimum": 0,
      "title": "Scanned Files",
      "type": "integer"
    },
    "scanner_error_count": {
      "minimum": 0,
      "title": "Scanner Error Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "structured_files": {
      "minimum": 0,
      "title": "Structured Files",
      "type": "integer"
    }
  },
  "required": [
    "report_id",
    "policy_hash",
    "root_count",
    "scanned_files",
    "scanned_bytes",
    "structured_files",
    "binary_files",
    "hard_secret_leak_count",
    "diagnostic_security_vocabulary_count",
    "scanner_error_count",
    "findings",
    "artifacts",
    "gate",
    "report_hash"
  ],
  "title": "SecurityScanReport",
  "type": "object"
}
