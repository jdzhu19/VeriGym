  "$id": "https://verigym.dev/schemas/1.0/action.schema.json",
  "discriminator": {
    "mapping": {
      "abort": "#/$defs/AbortAction",
      "apply_patch": "#/$defs/ApplyPatchAction",
      "final": "#/$defs/FinalSubmissionAction",
      "message": "#/$defs/MessageAction",
      "tool_call": "#/$defs/ToolCallAction"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/MessageAction"
    },
    {
      "$ref": "#/$defs/ToolCallAction"
    },
    {
      "$ref": "#/$defs/ApplyPatchAction"
    },
    {
      "$ref": "#/$defs/FinalSubmissionAction"
    },
    {
      "$ref": "#/$defs/AbortAction"
    }
  ]
}
