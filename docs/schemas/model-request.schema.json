{
  "$defs": {
    "ModelMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ModelMessage",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/model-request.schema.json",
  "additionalProperties": false,
  "properties": {
    "max_output_tokens": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Output Tokens"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ModelMessage"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stop": {
      "items": {
        "type": "string"
      },
      "title": "Stop",
      "type": "array"
    },
    "temperature": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Temperature",
      "type": "number"
    },
    "top_p": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Top P"
    }
  },
  "required": [
    "request_id",
    "messages"
  ],
  "title": "ModelRequest",
  "type": "object"
}
