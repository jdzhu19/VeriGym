      "title": "Process Kind",
      "type": "string"
    },
    "reasoning_effort": {
      "title": "Reasoning Effort",
      "type": "string"
    },
    "record_hash": {
      "title": "Record Hash",
      "type": "string"
    },
    "record_phase": {
