{
  "$id": "https://verigym.dev/schemas/1.0/agent-feedback-contract.schema.json",
  "additionalProperties": false,
  "description": "Run-time resolved feedback contract bound before a model is consulted.",
  "properties": {
    "benchmark_variant": {
      "title": "Benchmark Variant",
      "type": "string"
    },
    "compile_required_for_finish": {
      "title": "Compile Required For Finish",
      "type": "boolean"
    },
    "compile_test_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compile Test Id"
    },
    "configuration_fingerprint": {
      "title": "Configuration Fingerprint",
      "type": "string"
    },
    "contract_id": {
      "const": "agent_feedback_contract.v1",
      "default": "agent_feedback_contract.v1",
      "title": "Contract Id",
      "type": "string"
    },
    "patch_invalidates_compile": {
      "const": true,
      "default": true,
      "title": "Patch Invalidates Compile",
      "type": "boolean"
    },
    "patch_invalidates_diff": {
      "const": true,
      "default": true,
      "title": "Patch Invalidates Diff",
      "type": "boolean"
    },
    "patch_invalidates_ppa": {
      "const": true,
      "default": true,
      "title": "Patch Invalidates Ppa",
      "type": "boolean"
    },
    "ppa_enabled": {
      "title": "Ppa Enabled",
      "type": "boolean"
    },
    "ppa_max_executions": {
      "default": 3,
      "maximum": 8,
      "minimum": 1,
      "title": "Ppa Max Executions",
      "type": "integer"
    },
    "ppa_requires_compile": {
      "const": true,
      "default": true,
      "title": "Ppa Requires Compile",
      "type": "boolean"
    },
    "ppa_supported": {
      "title": "Ppa Supported",
      "type": "boolean"
    },
    "ppa_test_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ppa Test Id"
    },
    "profile_backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Backend"
    },
    "public_test_contract_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Public Test Contract Hash"
    },
    "public_test_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "title": "Public Test Ids",
      "type": "array"
    },
    "resolved_profile_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Profile Hash"
    },
    "resolver_id": {
      "const": "agent_feedback_contract_resolver_v1",
      "default": "agent_feedback_contract_resolver_v1",
      "title": "Resolver Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_machine_id": {
      "const": "repository_action_state_machine_v3",
      "default": "repository_action_state_machine_v3",
      "title": "State Machine Id",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "benchmark_variant",
    "compile_required_for_finish",
    "ppa_supported",
    "ppa_enabled",
    "configuration_fingerprint"
  ],
  "title": "AgentFeedbackContract",
  "type": "object"
}
