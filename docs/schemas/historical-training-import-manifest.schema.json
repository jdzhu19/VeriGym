  "$id": "https://verigym.dev/schemas/1.0/historical-training-import-manifest.schema.json",
  "additionalProperties": false,
  "description": "Campaign-wide all-or-none decision for one immutable training triplet.",
  "properties": {
    "all_or_none_policy": {
      "const": true,
      "default": true,
      "title": "All Or None Policy",
      "type": "boolean"
    },
    "episodes": {
      "items": {
        "$ref": "#/$defs/HistoricalTrainingEpisodeImportEligibility"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Episodes",
      "type": "array"
    },
    "exporter_source_commit": {
      "title": "Exporter Source Commit",
      "type": "string"
    },
    "import_all": {
      "title": "Import All",
      "type": "boolean"
    },
    "import_id": {
      "title": "Import Id",
      "type": "string"
    },
    "manifest_hash": {
      "title": "Manifest Hash",
      "type": "string"
    },
    "mixed_sources": {
      "const": false,
      "default": false,
      "title": "Mixed Sources",
      "type": "boolean"
    },
    "rerun_all": {
      "title": "Rerun All",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_bundle_sha256sums_hash": {
      "title": "Source Bundle Sha256Sums Hash",
      "type": "string"
    }
