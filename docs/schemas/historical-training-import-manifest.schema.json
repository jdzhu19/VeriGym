        "original_artifact_manifest_hash": {
          "title": "Original Artifact Manifest Hash",
          "type": "string"
        },
        "original_run_manifest_hash": {
          "title": "Original Run Manifest Hash",
          "type": "string"
        },
        "original_source_commit": {
          "title": "Original Source Commit",
          "type": "string"
        },
        "outcome_kind": {
          "title": "Outcome Kind",
          "type": "string"
        },
        "record_hash": {
          "title": "Record Hash",
          "type": "string"
        },
        "reward_hash": {
          "title": "Reward Hash",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "trajectory_hash": {
          "title": "Trajectory Hash",
          "type": "string"
        }
