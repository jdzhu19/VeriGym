        "task_id",
        "outcome_kind",
        "eligible",
        "checks",
        "original_run_manifest_hash",
        "original_artifact_manifest_hash",
        "original_source_commit",
        "exporter_source_commit",
        "trajectory_hash",
        "reward_hash",
        "record_hash"
      ],
      "title": "HistoricalTrainingEpisodeImportEligibility",
      "type": "object"
    }
