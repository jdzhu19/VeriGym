{
  "$defs": {
    "PassAtKEntry": {
      "additionalProperties": false,
      "properties": {
        "c": {
          "minimum": 0,
          "title": "C",
          "type": "integer"
        },
        "invalid_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Reason"
        },
        "k": {
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "k",
        "n",
        "c",
        "valid"
      ],
      "title": "PassAtKEntry",
      "type": "object"
    },
    "SampleOutcome": {
      "enum": [
        "resolved",
        "candidate_failure",
        "model_output_failure",
        "infrastructure_error",
        "cancelled_truncated"
      ],
      "title": "SampleOutcome",
      "type": "string"
    },
    "SampleRunRef": {
      "additionalProperties": false,
      "properties": {
        "candidate_verdict": {
          "title": "Candidate Verdict",
          "type": "boolean"
        },
        "configuration_fingerprint": {
          "title": "Configuration Fingerprint",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/SampleOutcome"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sample_index": {
          "minimum": 0,
          "title": "Sample Index",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "task_hash": {
          "title": "Task Hash",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "sample_index",
        "seed",
        "run_id",
        "task_id",
        "relative_path",
        "outcome",
        "resolved",
        "candidate_verdict",
        "task_hash",
        "source_hash",
        "configuration_fingerprint"
      ],
      "title": "SampleRunRef",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/pass-at-k-report.schema.json",
  "additionalProperties": false,
  "properties": {
    "any_resolved": {
      "title": "Any Resolved",
      "type": "boolean"
    },
    "cancelled_truncated_count": {
      "minimum": 0,
      "title": "Cancelled Truncated Count",
      "type": "integer"
    },
    "candidate_failure_count": {
      "minimum": 0,
      "title": "Candidate Failure Count",
      "type": "integer"
    },
    "canonical_valid": {
      "title": "Canonical Valid",
      "type": "boolean"
    },
    "child_runs": {
      "items": {
        "$ref": "#/$defs/SampleRunRef"
      },
      "title": "Child Runs",
      "type": "array"
    },
    "empirical_resolved_fraction": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Empirical Resolved Fraction"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/PassAtKEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "homogeneity_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Homogeneity Error"
    },
    "homogeneous": {
      "title": "Homogeneous",
      "type": "boolean"
    },
    "infrastructure_error_count": {
      "minimum": 0,
      "title": "Infrastructure Error Count",
      "type": "integer"
    },
    "missing_child_count": {
      "minimum": 0,
      "title": "Missing Child Count",
      "type": "integer"
    },
    "model_output_failure_count": {
      "minimum": 0,
      "title": "Model Output Failure Count",
      "type": "integer"
    },
    "requested_sample_count": {
      "minimum": 1,
      "title": "Requested Sample Count",
      "type": "integer"
    },
    "resolved_count": {
      "minimum": 0,
      "title": "Resolved Count",
      "type": "integer"
    },
    "sample_set_id": {
      "title": "Sample Set Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "valid_candidate_verdict_count": {
      "minimum": 0,
      "title": "Valid Candidate Verdict Count",
      "type": "integer"
    }
  },
  "required": [
    "sample_set_id",
    "task_id",
    "requested_sample_count",
    "valid_candidate_verdict_count",
    "resolved_count",
    "candidate_failure_count",
    "model_output_failure_count",
    "infrastructure_error_count",
    "cancelled_truncated_count",
    "missing_child_count",
    "any_resolved",
    "homogeneous",
    "canonical_valid",
    "entries",
    "child_runs"
  ],
  "title": "PassAtKReport",
  "type": "object"
}
