{
  "$defs": {
    "MemoryPackSection": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "section": {
          "enum": [
            "principles",
            "public_test_strategy",
            "workspace_policy_reminders",
            "debugging_checklist",
            "patch_discipline"
          ],
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "section",
        "items"
      ],
      "title": "MemoryPackSection",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/memory-pack.schema.json",
  "additionalProperties": false,
  "properties": {
    "code_free": {
      "const": true,
      "default": true,
      "title": "Code Free",
      "type": "boolean"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "memory_pack_id": {
      "title": "Memory Pack Id",
      "type": "string"
    },
    "policy_id": {
      "const": "task_independent_code_free_memory_v1",
      "default": "task_independent_code_free_memory_v1",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/MemoryPackSection"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Sections",
      "type": "array"
    },
    "task_independent": {
      "const": true,
      "default": true,
      "title": "Task Independent",
      "type": "boolean"
    },
    "total_utf8_bytes": {
      "maximum": 16384,
      "minimum": 1,
      "title": "Total Utf8 Bytes",
      "type": "integer"
    }
  },
  "required": [
    "memory_pack_id",
    "sections",
    "total_utf8_bytes",
    "content_hash"
  ],
  "title": "MemoryPack",
  "type": "object"
}
