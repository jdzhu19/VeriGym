{
  "$defs": {
    "SynthesisArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "generated_script",
            "tool_log",
            "statistics",
            "netlist_json",
            "netlist_verilog"
          ],
          "title": "Role",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "visibility": {
          "enum": [
            "public",
            "verifier_private",
            "summary_only"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_hash",
        "size_bytes",
        "role",
        "visibility"
      ],
      "title": "SynthesisArtifactRef",
      "type": "object"
    },
    "SynthesisDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "title": "SynthesisDiagnostic",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/synthesis-metrics.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/SynthesisArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "cells_by_type": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Cells By Type",
      "type": "object"
    },
    "failure_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Category"
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "generated_script_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated Script Hash"
    },
    "mapped_area_raw": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapped Area Raw"
    },
    "mapped_area_source_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapped Area Source Hash"
    },
    "mapped_area_unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapped Area Unit"
    },
    "num_cells": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Num Cells"
    },
    "num_memories": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Num Memories"
    },
    "num_memory_bits": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Num Memory Bits"
    },
    "num_processes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Num Processes"
    },
    "num_wire_bits": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Num Wire Bits"
    },
    "num_wires": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Num Wires"
    },
    "resolved_profile_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Profile Hash"
    },
    "role": {
      "enum": [
        "candidate",
        "reference"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "error",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "synthesis_ok": {
      "title": "Synthesis Ok",
      "type": "boolean"
    },
    "tool_identity": {
      "additionalProperties": true,
      "title": "Tool Identity",
      "type": "object"
    },
    "top": {
      "title": "Top",
      "type": "string"
    },
    "unsupported_constructs": {
      "items": {
        "$ref": "#/$defs/SynthesisDiagnostic"
      },
      "title": "Unsupported Constructs",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/SynthesisDiagnostic"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "synthesis_ok",
    "role",
    "top"
  ],
  "title": "SynthesisMetrics",
  "type": "object"
}
