{
  "$defs": {
    "RewardChannelStatistics": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "minimum": 0,
          "title": "Available",
          "type": "integer"
        },
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "enum": [
            "binary",
            "count",
            "lines",
            "seconds",
            "tokens"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "unit",
        "available",
        "missing"
      ],
      "title": "RewardChannelStatistics",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/reward-analysis-report.schema.json",
  "additionalProperties": false,
  "properties": {
    "channels": {
      "items": {
        "$ref": "#/$defs/RewardChannelStatistics"
      },
      "title": "Channels",
      "type": "array"
    },
    "dataset_hash": {
      "title": "Dataset Hash",
      "type": "string"
    },
    "outcome_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "resolved_candidate",
          "incorrect_policy_compliant_candidate",
          "contained_workspace_policy_failure",
          "strict_output_failure",
          "infrastructure_invalid",
          "cancelled_or_interrupted"
        ]
      },
      "title": "Outcome Counts",
      "type": "object"
    },
    "record_count": {
      "minimum": 0,
      "title": "Record Count",
      "type": "integer"
    },
    "report_hash": {
      "title": "Report Hash",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "reward_profile_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reward Profile Hash"
    },
    "reward_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reward Profile Id"
    },
    "reward_schema_id": {
      "const": "repo_rtl_reward_vector_v1",
      "default": "repo_rtl_reward_vector_v1",
      "title": "Reward Schema Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "universal_benchmark_score": {
      "const": false,
      "default": false,
      "title": "Universal Benchmark Score",
      "type": "boolean"
    },
    "vector_authoritative": {
      "const": true,
      "default": true,
      "title": "Vector Authoritative",
      "type": "boolean"
    }
  },
  "required": [
    "report_id",
    "dataset_hash",
    "record_count",
    "outcome_counts",
    "channels",
    "report_hash"
  ],
  "title": "RewardAnalysisReport",
  "type": "object"
}
