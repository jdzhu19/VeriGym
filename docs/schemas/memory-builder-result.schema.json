{
  "$defs": {
    "MemoryPack": {
      "additionalProperties": false,
      "properties": {
        "code_free": {
          "const": true,
          "default": true,
          "title": "Code Free",
          "type": "boolean"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "memory_pack_id": {
          "title": "Memory Pack Id",
          "type": "string"
        },
        "policy_id": {
          "const": "task_independent_code_free_memory_v1",
          "default": "task_independent_code_free_memory_v1",
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/MemoryPackSection"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Sections",
          "type": "array"
        },
        "task_independent": {
          "const": true,
          "default": true,
          "title": "Task Independent",
          "type": "boolean"
        },
        "total_utf8_bytes": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Total Utf8 Bytes",
          "type": "integer"
        }
      },
      "required": [
        "memory_pack_id",
        "sections",
        "total_utf8_bytes",
        "content_hash"
      ],
      "title": "MemoryPack",
      "type": "object"
    },
    "MemoryPackSection": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "section": {
          "enum": [
            "principles",
            "public_test_strategy",
            "workspace_policy_reminders",
            "debugging_checklist",
            "patch_discipline"
          ],
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "section",
        "items"
      ],
      "title": "MemoryPackSection",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/memory-builder-result.schema.json",
  "additionalProperties": false,
  "properties": {
    "build_id": {
      "title": "Build Id",
      "type": "string"
    },
    "credentials_exported": {
      "const": false,
      "default": false,
      "title": "Credentials Exported",
      "type": "boolean"
    },
    "failure_reason": {
      "anyOf": [
        {
          "enum": [
            "process_timeout",
            "process_output_limit",
            "process_nonzero_exit",
            "runtime_security_incomplete",
            "event_stream_parse_error",
            "terminal_stream_incomplete",
            "event_policy_rejected",
            "workspace_not_empty_before",
            "workspace_not_empty_after",
            "workspace_changed",
            "memory_policy_code_fence",
            "memory_policy_rtl_code",
            "memory_policy_task_id",
            "memory_policy_repository_path",
            "memory_policy_hash",
            "memory_policy_hidden_or_reference",
            "memory_policy_credential",
            "memory_policy_heldout_only",
            "memory_output_invalid"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "heldout_assets_available": {
      "const": false,
      "default": false,
      "title": "Heldout Assets Available",
      "type": "boolean"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "invocation_spec_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invocation Spec Hash"
    },
    "memory_pack": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryPack"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "memory_synthesis_plan_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Synthesis Plan Hash"
    },
    "model_processes_started": {
      "const": 1,
      "default": 1,
      "title": "Model Processes Started",
      "type": "integer"
    },
    "output_hash": {
      "title": "Output Hash",
      "type": "string"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "payload_binding_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Binding Hash"
    },
    "private_reasoning_exported": {
      "const": false,
      "default": false,
      "title": "Private Reasoning Exported",
      "type": "boolean"
    },
    "process_identity_hash": {
      "title": "Process Identity Hash",
      "type": "string"
    },
    "process_ledger_record_hash": {
      "title": "Process Ledger Record Hash",
      "type": "string"
    },
    "redacted_output_hash": {
      "title": "Redacted Output Hash",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "parser_error",
        "content_policy_rejected",
        "process_failure"
      ],
      "title": "Status",
      "type": "string"
    },
    "wall_time_s": {
      "minimum": 0,
      "title": "Wall Time S",
      "type": "number"
    }
  },
  "required": [
    "build_id",
    "status",
    "input_hash",
    "process_identity_hash",
    "process_ledger_record_hash",
    "redacted_output_hash",
    "wall_time_s",
    "output_hash"
  ],
  "title": "MemoryBuilderResult",
  "type": "object"
}
