{
  "$id": "https://verigym.dev/schemas/1.0/hwe-deepseek-harness-action-sft.schema.json",
  "additionalProperties": false,
  "description": "One untruncated, final-action-only row derived from exact Harness context.",
  "properties": {
    "action_index": {
      "minimum": 0,
      "title": "Action Index",
      "type": "integer"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "candidate_hash": {
      "title": "Candidate Hash",
      "type": "string"
    },
    "chat_template_hash": {
      "title": "Chat Template Hash",
      "type": "string"
    },
    "context_transformed_after_collection": {
      "const": false,
      "title": "Context Transformed After Collection",
      "type": "boolean"
    },
    "credential_values_exported": {
      "const": false,
      "title": "Credential Values Exported",
      "type": "boolean"
    },
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "exact_model_visible_context": {
      "const": true,
      "title": "Exact Model Visible Context",
      "type": "boolean"
    },
    "format_id": {
      "const": "verigym_hwe_deepseek_harness_action_sft_v1",
      "title": "Format Id",
      "type": "string"
    },
    "hidden_assets_exported": {
      "const": false,
      "title": "Hidden Assets Exported",
      "type": "boolean"
    },
    "infrastructure_valid": {
      "const": true,
      "title": "Infrastructure Valid",
      "type": "boolean"
    },
    "input_messages": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 2,
      "title": "Input Messages",
      "type": "array"
    },
    "input_tokens": {
      "minimum": 1,
      "title": "Input Tokens",
      "type": "integer"
    },
    "masked_roles": {
      "items": {
        "enum": [
          "system",
          "user",
          "tool"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Masked Roles",
      "type": "array"
    },
    "max_length": {
      "const": 32768,
      "title": "Max Length",
      "type": "integer"
    },
    "nap_required": {
      "const": false,
      "title": "Nap Required",
      "type": "boolean"
    },
    "private_reasoning_exported": {
      "const": false,
      "title": "Private Reasoning Exported",
      "type": "boolean"
    },
    "raw_host_paths_exported": {
      "const": false,
      "title": "Raw Host Paths Exported",
      "type": "boolean"
    },
    "raw_observations_exported": {
      "const": false,
      "title": "Raw Observations Exported",
      "type": "boolean"
    },
    "raw_provider_events_exported": {
      "const": false,
      "title": "Raw Provider Events Exported",
      "type": "boolean"
    },
    "record_hash": {
      "title": "Record Hash",
      "type": "string"
    },
    "reference_solutions_exported": {
      "const": false,
      "title": "Reference Solutions Exported",
      "type": "boolean"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "supervised_roles": {
      "items": {
        "const": "assistant",
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Supervised Roles",
      "type": "array"
    },
    "target_message": {
      "additionalProperties": true,
      "title": "Target Message",
      "type": "object"
    },
    "target_tokens": {
      "minimum": 1,
      "title": "Target Tokens",
      "type": "integer"
    },
    "task_hash": {
      "title": "Task Hash",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "token_count": {
      "minimum": 1,
      "title": "Token Count",
      "type": "integer"
    },
    "tokenizer_hash": {
      "title": "Tokenizer Hash",
      "type": "string"
    },
    "tokenizer_id": {
      "const": "Qwen3.5-9B/local-frozen-chat-template",
      "title": "Tokenizer Id",
      "type": "string"
    },
    "tools": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Tools",
      "type": "array"
    },
    "transcript_hash": {
      "title": "Transcript Hash",
      "type": "string"
    },
    "truncation": {
      "const": "error",
      "title": "Truncation",
      "type": "string"
    },
    "verifier_hash": {
      "title": "Verifier Hash",
      "type": "string"
    },
    "verifier_resolved": {
      "const": true,
      "title": "Verifier Resolved",
      "type": "boolean"
    }
  },
  "required": [
    "format_id",
    "sample_id",
    "task_id",
    "task_hash",
    "source_hash",
    "candidate_hash",
    "verifier_hash",
    "transcript_hash",
    "action_index",
    "call_id",
    "tools",
    "input_messages",
    "target_message",
    "tokenizer_id",
    "tokenizer_hash",
    "chat_template_hash",
    "input_tokens",
    "target_tokens",
    "token_count",
    "max_length",
    "truncation",
    "eligible",
    "supervised_roles",
    "masked_roles",
    "exact_model_visible_context",
    "context_transformed_after_collection",
    "nap_required",
    "verifier_resolved",
    "infrastructure_valid",
    "raw_provider_events_exported",
    "raw_observations_exported",
    "private_reasoning_exported",
    "hidden_assets_exported",
    "reference_solutions_exported",
    "credential_values_exported",
    "raw_host_paths_exported",
    "record_hash"
  ],
  "title": "HweDeepSeekHarnessActionSftExample",
  "type": "object"
}
