{
  "$id": "https://verigym.dev/schemas/1.0/repository-public-test-outcome.schema.json",
  "additionalProperties": false,
  "description": "Bounded result from the trusted public-test launcher.",
  "properties": {
    "category": {
      "title": "Category",
      "type": "string"
    },
    "duration_s": {
      "minimum": 0.0,
      "title": "Duration S",
      "type": "number"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "launcher_protocol": {
      "const": "verigym_public_test_v1",
      "title": "Launcher Protocol",
      "type": "string"
    },
    "network_policy": {
      "enum": [
        "none",
        "host_local_trusted"
      ],
      "title": "Network Policy",
      "type": "string"
    },
    "output_truncated": {
      "title": "Output Truncated",
      "type": "boolean"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "public_assets_read_only": {
      "title": "Public Assets Read Only",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stderr_sha256": {
      "title": "Stderr Sha256",
      "type": "string"
    },
    "stdout_sha256": {
      "title": "Stdout Sha256",
      "type": "string"
    },
    "test_id": {
      "title": "Test Id",
      "type": "string"
    }
  },
  "required": [
    "test_id",
    "passed",
    "category",
    "duration_s",
    "output_truncated",
    "stdout_sha256",
    "stderr_sha256",
    "launcher_protocol",
    "public_assets_read_only",
    "network_policy"
  ],
  "title": "RepositoryPublicTestOutcome",
  "type": "object"
}
