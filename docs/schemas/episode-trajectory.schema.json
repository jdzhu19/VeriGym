{
  "$defs": {
    "JsonValue": {},
    "RewardVector": {
      "additionalProperties": false,
      "properties": {
        "added_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Added Lines"
        },
        "candidate_compile_passed": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Compile Passed"
        },
        "changed_file_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed File Count"
        },
        "deleted_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deleted Lines"
        },
        "hidden_regression_passed": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hidden Regression Passed"
        },
        "infrastructure_valid": {
          "enum": [
            0,
            1
          ],
          "title": "Infrastructure Valid",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "outcome_kind": {
          "enum": [
            "resolved_candidate",
            "incorrect_policy_compliant_candidate",
            "contained_workspace_policy_failure",
            "strict_output_failure",
            "infrastructure_invalid",
            "cancelled_or_interrupted"
          ],
          "title": "Outcome Kind",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "patch_reproducible": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Patch Reproducible"
        },
        "policy_compliance": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy Compliance"
        },
        "public_test_passed": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Public Test Passed"
        },
        "public_test_reached": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Public Test Reached"
        },
        "public_tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Tool Calls"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_resolved": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Resolved"
        },
        "wall_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Time S"
        }
      },
      "required": [
        "outcome_kind",
        "infrastructure_valid",
        "policy_compliance",
        "public_test_reached",
        "public_test_passed",
        "patch_reproducible",
        "candidate_compile_passed",
        "hidden_regression_passed",
        "task_resolved"
      ],
      "title": "RewardVector",
      "type": "object"
    },
    "TrajectoryEligibility": {
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "eligible",
            "infrastructure_invalid",
            "cancelled_or_interrupted",
            "integrity_invalid",
            "content_policy_rejected"
          ],
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "eligible",
        "reason"
      ],
      "title": "TrajectoryEligibility",
      "type": "object"
    },
    "TrajectoryEvent": {
      "additionalProperties": false,
      "properties": {
        "content_class": {
          "enum": [
            "public_task",
            "public_tool_output",
            "agent_generated",
            "workspace_metadata",
            "candidate_public",
            "score_summary",
            "sensitive_redacted"
          ],
          "title": "Content Class",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "task_observation",
            "agent_message",
            "tool_invocation",
            "tool_result",
            "workspace_delta",
            "public_test",
            "candidate_freeze",
            "episode_outcome",
            "usage",
            "reward"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "payload_sha256": {
          "title": "Payload Sha256",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "sequence",
        "event_type",
        "content_class",
        "payload",
        "payload_sha256"
      ],
      "title": "TrajectoryEvent",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/episode-trajectory.schema.json",
  "additionalProperties": false,
  "properties": {
    "agent_version_hash": {
      "title": "Agent Version Hash",
      "type": "string"
    },
    "agent_version_id": {
      "title": "Agent Version Id",
      "type": "string"
    },
    "artifact_manifest_hash": {
      "title": "Artifact Manifest Hash",
      "type": "string"
    },
    "auth_semantic_id": {
      "title": "Auth Semantic Id",
      "type": "string"
    },
    "base_repository_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Repository Hash"
    },
    "base_seed": {
      "minimum": 0,
      "title": "Base Seed",
      "type": "integer"
    },
    "codex_identity_hash": {
      "title": "Codex Identity Hash",
      "type": "string"
    },
    "credential_values_exported": {
      "const": false,
      "default": false,
      "title": "Credential Values Exported",
      "type": "boolean"
    },
    "eligibility": {
      "$ref": "#/$defs/TrajectoryEligibility"
    },
    "event_count": {
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TrajectoryEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "events_hash": {
      "title": "Events Hash",
      "type": "string"
    },
    "experiment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Id"
    },
    "export_policy_id": {
      "const": "observable_repo_trajectory_v1",
      "default": "observable_repo_trajectory_v1",
      "title": "Export Policy Id",
      "type": "string"
    },
    "hidden_assets_exported": {
      "const": false,
      "default": false,
      "title": "Hidden Assets Exported",
      "type": "boolean"
    },
    "image_identity_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Identity Hash"
    },
    "memory_pack_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Pack Hash"
    },
    "model_identity_hash": {
      "title": "Model Identity Hash",
      "type": "string"
    },
    "plan_item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Item Id"
    },
    "private_reasoning_exported": {
      "const": false,
      "default": false,
      "title": "Private Reasoning Exported",
      "type": "boolean"
    },
    "prompt_hash": {
      "title": "Prompt Hash",
      "type": "string"
    },
    "raw_host_paths_exported": {
      "const": false,
      "default": false,
      "title": "Raw Host Paths Exported",
      "type": "boolean"
    },
    "reference_solution_exported": {
      "const": false,
      "default": false,
      "title": "Reference Solution Exported",
      "type": "boolean"
    },
    "reward": {
      "$ref": "#/$defs/RewardVector"
    },
    "reward_hash": {
      "title": "Reward Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_manifest_hash": {
      "title": "Run Manifest Hash",
      "type": "string"
    },
    "runtime_identity_hash": {
      "title": "Runtime Identity Hash",
      "type": "string"
    },
    "sample_index": {
      "minimum": 0,
      "title": "Sample Index",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scorecard_hash": {
      "title": "Scorecard Hash",
      "type": "string"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "split": {
      "enum": [
        "training",
        "validation",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "split_id": {
      "title": "Split Id",
      "type": "string"
    },
    "task_hash": {
      "title": "Task Hash",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "toolchain_identity_hash": {
      "title": "Toolchain Identity Hash",
      "type": "string"
    },
    "total_bytes": {
      "minimum": 0,
      "title": "Total Bytes",
      "type": "integer"
    },
    "trajectory_hash": {
      "title": "Trajectory Hash",
      "type": "string"
    },
    "trajectory_id": {
      "title": "Trajectory Id",
      "type": "string"
    },
    "verifier_identity_hash": {
      "title": "Verifier Identity Hash",
      "type": "string"
    }
  },
  "required": [
    "trajectory_id",
    "run_id",
    "task_id",
    "task_hash",
    "source_hash",
    "split_id",
    "split",
    "agent_version_id",
    "agent_version_hash",
    "model_identity_hash",
    "codex_identity_hash",
    "auth_semantic_id",
    "prompt_hash",
    "runtime_identity_hash",
    "verifier_identity_hash",
    "toolchain_identity_hash",
    "base_seed",
    "sample_index",
    "events",
    "event_count",
    "events_hash",
    "run_manifest_hash",
    "scorecard_hash",
    "artifact_manifest_hash",
    "eligibility",
    "reward",
    "reward_hash",
    "total_bytes",
    "trajectory_hash"
  ],
  "title": "EpisodeTrajectory",
  "type": "object"
}
