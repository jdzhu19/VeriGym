{
  "$id": "https://verigym.dev/schemas/1.0/provider-request-identity.schema.json",
  "additionalProperties": false,
  "description": "Secret-free identity of one credential-bearing remote request.",
  "properties": {
    "action_protocol_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Protocol Hash"
    },
    "agent_configuration_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Configuration Hash"
    },
    "authentication_mode": {
      "enum": [
        "bearer_env",
        "bearer_explicit_in_memory"
      ],
      "title": "Authentication Mode",
      "type": "string"
    },
    "base_url_hash": {
      "title": "Base Url Hash",
      "type": "string"
    },
    "connect_timeout_s": {
      "exclusiveMinimum": 0.0,
      "title": "Connect Timeout S",
      "type": "number"
    },
    "credential_env_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Env Name"
    },
    "credential_hashed": {
      "const": false,
      "default": false,
      "title": "Credential Hashed",
      "type": "boolean"
    },
    "credential_persisted": {
      "const": false,
      "default": false,
      "title": "Credential Persisted",
      "type": "boolean"
    },
    "endpoint_origin": {
      "title": "Endpoint Origin",
      "type": "string"
    },
    "max_response_bytes": {
      "minimum": 1024,
      "title": "Max Response Bytes",
      "type": "integer"
    },
    "normalized_base_url": {
      "title": "Normalized Base Url",
      "type": "string"
    },
    "prompt_payload_hash": {
      "title": "Prompt Payload Hash",
      "type": "string"
    },
    "prompt_policy_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Policy Hash"
    },
    "protocol": {
      "const": "openai_compatible",
      "title": "Protocol",
      "type": "string"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "read_timeout_s": {
      "exclusiveMinimum": 0.0,
      "title": "Read Timeout S",
      "type": "number"
    },
    "request_parameters_hash": {
      "title": "Request Parameters Hash",
      "type": "string"
    },
    "request_timeout_s": {
      "exclusiveMinimum": 0.0,
      "title": "Request Timeout S",
      "type": "number"
    },
    "requested_model_id": {
      "title": "Requested Model Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "protocol",
    "requested_model_id",
    "endpoint_origin",
    "normalized_base_url",
    "base_url_hash",
    "request_parameters_hash",
    "prompt_payload_hash",
    "connect_timeout_s",
    "read_timeout_s",
    "request_timeout_s",
    "max_response_bytes",
    "authentication_mode"
  ],
  "title": "ProviderRequestIdentity",
  "type": "object"
}
