{
  "$defs": {
    "GenerationParameters": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "temperature": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "GenerationParameters",
      "type": "object"
    },
    "NormalizedModelUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "NormalizedModelUsage",
      "type": "object"
    },
    "ProviderRequestIdentity": {
      "additionalProperties": false,
      "description": "Secret-free identity of one credential-bearing remote request.",
      "properties": {
        "action_protocol_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Protocol Hash"
        },
        "agent_configuration_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Configuration Hash"
        },
        "authentication_mode": {
          "enum": [
            "bearer_env",
            "bearer_explicit_in_memory"
          ],
          "title": "Authentication Mode",
          "type": "string"
        },
        "base_url_hash": {
          "title": "Base Url Hash",
          "type": "string"
        },
        "connect_timeout_s": {
          "exclusiveMinimum": 0.0,
          "title": "Connect Timeout S",
          "type": "number"
        },
        "credential_env_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Env Name"
        },
        "credential_hashed": {
          "const": false,
          "default": false,
          "title": "Credential Hashed",
          "type": "boolean"
        },
        "credential_persisted": {
          "const": false,
          "default": false,
          "title": "Credential Persisted",
          "type": "boolean"
        },
        "endpoint_origin": {
          "title": "Endpoint Origin",
          "type": "string"
        },
        "max_response_bytes": {
          "minimum": 1024,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "normalized_base_url": {
          "title": "Normalized Base Url",
          "type": "string"
        },
        "prompt_payload_hash": {
          "title": "Prompt Payload Hash",
          "type": "string"
        },
        "prompt_policy_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Policy Hash"
        },
        "protocol": {
          "const": "openai_compatible",
          "title": "Protocol",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "read_timeout_s": {
          "exclusiveMinimum": 0.0,
          "title": "Read Timeout S",
          "type": "number"
        },
        "request_parameters_hash": {
          "title": "Request Parameters Hash",
          "type": "string"
        },
        "request_timeout_s": {
          "exclusiveMinimum": 0.0,
          "title": "Request Timeout S",
          "type": "number"
        },
        "requested_model_id": {
          "title": "Requested Model Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "protocol",
        "requested_model_id",
        "endpoint_origin",
        "normalized_base_url",
        "base_url_hash",
        "request_parameters_hash",
        "prompt_payload_hash",
        "connect_timeout_s",
        "read_timeout_s",
        "request_timeout_s",
        "max_response_bytes",
        "authentication_mode"
      ],
      "title": "ProviderRequestIdentity",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/model-call-identity.schema.json",
  "additionalProperties": false,
  "description": "Requested versus observed identity for one model call.",
  "properties": {
    "adapter_name": {
      "title": "Adapter Name",
      "type": "string"
    },
    "adapter_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Version"
    },
    "cost": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost"
    },
    "cost_currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Currency"
    },
    "cost_unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Unit"
    },
    "endpoint_origin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint Origin"
    },
    "generation": {
      "$ref": "#/$defs/GenerationParameters"
    },
    "identity_confidence": {
      "enum": [
        "exact",
        "provider_observed",
        "requested_only",
        "unknown"
      ],
      "title": "Identity Confidence",
      "type": "string"
    },
    "latency_s": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency S"
    },
    "mutable_remote_service": {
      "title": "Mutable Remote Service",
      "type": "boolean"
    },
    "observed_provider_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Provider Model Id"
    },
    "provider_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderRequestIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reproducibility_scope": {
      "enum": [
        "exact_offline_fixture",
        "mutable_remote_observation",
        "requested_remote_identity",
        "unknown"
      ],
      "title": "Reproducibility Scope",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "requested_model_id": {
      "title": "Requested Model Id",
      "type": "string"
    },
    "safe_provider_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safe Provider Request Id"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "system_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Fingerprint"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedModelUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage_missing": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage Missing"
    }
  },
  "required": [
    "request_id",
    "adapter_name",
    "requested_model_id",
    "generation",
    "identity_confidence",
    "reproducibility_scope",
    "mutable_remote_service"
  ],
  "title": "ModelCallIdentity",
  "type": "object"
}
