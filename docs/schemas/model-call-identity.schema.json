{
  "$defs": {
    "GenerationParameters": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "temperature": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "GenerationParameters",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/model-call-identity.schema.json",
  "additionalProperties": false,
  "description": "Requested versus observed identity for one model call.",
  "properties": {
    "adapter_name": {
      "title": "Adapter Name",
      "type": "string"
    },
    "adapter_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Version"
    },
    "endpoint_origin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint Origin"
    },
    "generation": {
      "$ref": "#/$defs/GenerationParameters"
    },
    "identity_confidence": {
      "enum": [
        "exact",
        "provider_observed",
        "requested_only",
        "unknown"
      ],
      "title": "Identity Confidence",
      "type": "string"
    },
    "mutable_remote_service": {
      "title": "Mutable Remote Service",
      "type": "boolean"
    },
    "observed_provider_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Provider Model Id"
    },
    "reproducibility_scope": {
      "enum": [
        "exact_offline_fixture",
        "mutable_remote_observation",
        "requested_remote_identity",
        "unknown"
      ],
      "title": "Reproducibility Scope",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "requested_model_id": {
      "title": "Requested Model Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "system_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Fingerprint"
    }
  },
  "required": [
    "request_id",
    "adapter_name",
    "requested_model_id",
    "generation",
    "identity_confidence",
    "reproducibility_scope",
    "mutable_remote_service"
  ],
  "title": "ModelCallIdentity",
  "type": "object"
}
