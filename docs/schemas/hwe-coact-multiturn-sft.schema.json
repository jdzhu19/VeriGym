{
  "$id": "https://verigym.dev/schemas/1.0/hwe-coact-multiturn-sft.schema.json",
  "additionalProperties": false,
  "description": "One complete, unsplit CoACT trajectory.",
  "properties": {
    "candidate_hash": {
      "title": "Candidate Hash",
      "type": "string"
    },
    "canonical_action_hashes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Canonical Action Hashes",
      "type": "array"
    },
    "compression_manifest": {
      "additionalProperties": true,
      "title": "Compression Manifest",
      "type": "object"
    },
    "credential_values_exported": {
      "const": false,
      "title": "Credential Values Exported",
      "type": "boolean"
    },
    "example_hash": {
      "title": "Example Hash",
      "type": "string"
    },
    "format_id": {
      "const": "verigym_hwe_coact_multiturn_sft_v1",
      "title": "Format Id",
      "type": "string"
    },
    "hidden_assets_exported": {
      "const": false,
      "title": "Hidden Assets Exported",
      "type": "boolean"
    },
    "infrastructure_valid": {
      "const": true,
      "title": "Infrastructure Valid",
      "type": "boolean"
    },
    "masked_roles": {
      "items": {
        "enum": [
          "system",
          "user",
          "tool"
        ],
        "type": "string"
      },
      "title": "Masked Roles",
      "type": "array"
    },
    "max_length": {
      "const": 65536,
      "title": "Max Length",
      "type": "integer"
    },
    "messages": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "primary_source_eligible": {
      "title": "Primary Source Eligible",
      "type": "boolean"
    },
    "private_reasoning_exported": {
      "const": false,
      "title": "Private Reasoning Exported",
      "type": "boolean"
    },
    "raw_host_paths_exported": {
      "const": false,
      "title": "Raw Host Paths Exported",
      "type": "boolean"
    },
    "raw_observations_exported": {
      "const": false,
      "title": "Raw Observations Exported",
      "type": "boolean"
    },
    "raw_provider_events_exported": {
      "const": false,
      "title": "Raw Provider Events Exported",
      "type": "boolean"
    },
    "reference_solutions_exported": {
      "const": false,
      "title": "Reference Solutions Exported",
      "type": "boolean"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "source_transcript_hash": {
      "title": "Source Transcript Hash",
      "type": "string"
    },
    "supervised_roles": {
      "items": {
        "const": "assistant",
        "type": "string"
      },
      "title": "Supervised Roles",
      "type": "array"
    },
    "task_hash": {
      "title": "Task Hash",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "token_count": {
      "maximum": 65536,
      "minimum": 1,
      "title": "Token Count",
      "type": "integer"
    },
    "truncation": {
      "const": "error",
      "title": "Truncation",
      "type": "string"
    },
    "verifier_hash": {
      "title": "Verifier Hash",
      "type": "string"
    },
    "verifier_resolved": {
      "const": true,
      "title": "Verifier Resolved",
      "type": "boolean"
    }
  },
  "required": [
    "format_id",
    "example_hash",
    "sample_id",
    "task_id",
    "task_hash",
    "source_hash",
    "candidate_hash",
    "verifier_hash",
    "source_transcript_hash",
    "messages",
    "token_count",
    "max_length",
    "truncation",
    "supervised_roles",
    "masked_roles",
    "canonical_action_hashes",
    "compression_manifest",
    "verifier_resolved",
    "infrastructure_valid",
    "primary_source_eligible",
    "raw_provider_events_exported",
    "raw_observations_exported",
    "private_reasoning_exported",
    "hidden_assets_exported",
    "reference_solutions_exported",
    "credential_values_exported",
    "raw_host_paths_exported"
  ],
  "title": "HweCoactExample",
  "type": "object"
}
