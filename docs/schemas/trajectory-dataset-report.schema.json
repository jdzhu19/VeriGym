{
  "$id": "https://verigym.dev/schemas/1.0/trajectory-dataset-report.schema.json",
  "additionalProperties": false,
  "properties": {
    "agent_version_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Agent Version Counts",
      "type": "object"
    },
    "dataset_hash": {
      "title": "Dataset Hash",
      "type": "string"
    },
    "eligible_count": {
      "minimum": 0,
      "title": "Eligible Count",
      "type": "integer"
    },
    "ineligible_count": {
      "minimum": 0,
      "title": "Ineligible Count",
      "type": "integer"
    },
    "no_model_calls": {
      "const": true,
      "default": true,
      "title": "No Model Calls",
      "type": "boolean"
    },
    "no_runtime_calls": {
      "const": true,
      "default": true,
      "title": "No Runtime Calls",
      "type": "boolean"
    },
    "outcome_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "resolved_candidate",
          "incorrect_policy_compliant_candidate",
          "contained_workspace_policy_failure",
          "strict_output_failure",
          "infrastructure_invalid",
          "cancelled_or_interrupted"
        ]
      },
      "title": "Outcome Counts",
      "type": "object"
    },
    "record_count": {
      "minimum": 0,
      "title": "Record Count",
      "type": "integer"
    },
    "report_hash": {
      "title": "Report Hash",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Split Counts",
      "type": "object"
    }
  },
  "required": [
    "report_id",
    "dataset_hash",
    "record_count",
    "eligible_count",
    "ineligible_count",
    "outcome_counts",
    "split_counts",
    "agent_version_counts",
    "report_hash"
  ],
  "title": "TrajectoryDatasetReport",
  "type": "object"
}
