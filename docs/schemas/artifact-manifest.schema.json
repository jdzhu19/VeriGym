{
  "$defs": {
    "ArtifactEntry": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "visibility": {
          "default": "public",
          "enum": [
            "public",
            "private_summary"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "role",
        "size_bytes",
        "sha256",
        "required",
        "content_type"
      ],
      "title": "ArtifactEntry",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/artifact-manifest.schema.json",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/ArtifactEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "entries_hash": {
      "title": "Entries Hash",
      "type": "string"
    },
    "owner_id": {
      "title": "Owner Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "enum": [
        "run",
        "experiment",
        "sample_set"
      ],
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "owner_id",
    "entries_hash",
    "entries"
  ],
  "title": "ArtifactManifest",
  "type": "object"
}
