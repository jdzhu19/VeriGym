          "type": "string"
        },
        "runtime_generated_globs": {
          "items": {
            "type": "string"
          },
          "title": "Runtime Generated Globs",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
