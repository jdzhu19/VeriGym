        },
        "max_output_bytes_per_tool": {
          "default": 1000000,
          "minimum": 1,
          "title": "Max Output Bytes Per Tool",
          "type": "integer"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "max_tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_tool_time_s": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Time S"
        },
        "max_total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Tokens"
        },
        "max_turns": {
          "default": 1,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        },
        "max_wall_time_s": {
          "default": 300,
          "minimum": 1,
          "title": "Max Wall Time S",
          "type": "integer"
        },
        "max_workspace_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Workspace Bytes"
        }
      },
