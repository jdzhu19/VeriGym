          "type": "boolean"
        },
        "allow_file_rename": {
          "const": false,
          "default": false,
          "title": "Allow File Rename",
          "type": "boolean"
        },
        "allow_mode_change": {
          "const": false,
          "default": false,
          "title": "Allow Mode Change",
          "type": "boolean"
        },
        "case_sensitive_paths": {
          "const": true,
          "default": true,
          "title": "Case Sensitive Paths",
          "type": "boolean"
