        "kind": {
          "enum": [
            "directory",
            "file",
            "inline"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mount_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mount Path"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "BudgetSpec": {
      "additionalProperties": false,
