    "ConditionSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "dependency_passed",
          "enum": [
            "always",
            "dependency_passed",
            "dependency_failed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node"
        }
      },
      "title": "ConditionSpec",
      "type": "object"
    },
    "InteractionMode": {
      "enum": [
        "chat",
        "agent",
        "train"
      ],
      "title": "InteractionMode",
      "type": "string"
    },
    "InteractionSpec": {
      "additionalProperties": false,
      "properties": {
        "allow_general_shell": {
          "default": false,
          "title": "Allow General Shell",
          "type": "boolean"
        },
        "allowed_tools": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "default_mode": {
          "$ref": "#/$defs/InteractionMode"
        },
        "denied_tools": {
          "items": {
            "type": "string"
          },
          "title": "Denied Tools",
          "type": "array"
        },
        "final_submission": {
          "$ref": "#/$defs/SubmissionPolicy"
        },
        "initial_observation": {
          "$ref": "#/$defs/ObservationPolicy"
        },
        "network_policy": {
          "default": "none",
          "enum": [
            "none",
            "allowlist",
            "open"
          ],
          "title": "Network Policy",
          "type": "string"
        },
        "supported_modes": {
          "items": {
            "$ref": "#/$defs/InteractionMode"
          },
          "title": "Supported Modes",
          "type": "array"
        }
      },
      "required": [
        "supported_modes",
        "default_mode",
        "allowed_tools"
      ],
      "title": "InteractionSpec",
      "type": "object"
    },
    "ObservationPolicy": {
      "additionalProperties": false,
      "properties": {
        "include_entrypoints": {
          "default": false,
          "title": "Include Entrypoints",
          "type": "boolean"
        },
        "include_readme": {
          "default": true,
          "title": "Include Readme",
          "type": "boolean"
