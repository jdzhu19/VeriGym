          "title": "Max Candidate Bytes",
          "type": "integer"
        },
        "max_changed_files": {
          "maximum": 256,
          "minimum": 1,
          "title": "Max Changed Files",
          "type": "integer"
        },
        "max_file_bytes": {
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_patch_lines": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Patch Lines",
          "type": "integer"
