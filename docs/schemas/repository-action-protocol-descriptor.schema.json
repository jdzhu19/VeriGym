{
  "$id": "https://verigym.dev/schemas/1.0/repository-action-protocol-descriptor.schema.json",
  "additionalProperties": false,
  "description": "Frozen effective protocol identity bound from plan through replay.",
  "properties": {
    "action_registry_hash": {
      "title": "Action Registry Hash",
      "type": "string"
    },
    "action_transport": {
      "enum": [
        "json_content",
        "native_tool_call"
      ],
      "title": "Action Transport",
      "type": "string"
    },
    "agent_descriptor_hash": {
      "title": "Agent Descriptor Hash",
      "type": "string"
    },
    "configuration_fingerprint": {
      "title": "Configuration Fingerprint",
      "type": "string"
    },
    "max_completion_calls": {
      "maximum": 128,
      "minimum": 1,
      "title": "Max Completion Calls",
      "type": "integer"
    },
    "max_response_bytes": {
      "maximum": 4194304,
      "minimum": 1024,
      "title": "Max Response Bytes",
      "type": "integer"
    },
    "normalizer_id": {
      "title": "Normalizer Id",
      "type": "string"
    },
    "one_action_per_turn": {
      "const": true,
      "default": true,
      "title": "One Action Per Turn",
      "type": "boolean"
    },
    "prompt_contract_hash": {
      "title": "Prompt Contract Hash",
      "type": "string"
    },
    "prompt_contract_id": {
      "title": "Prompt Contract Id",
      "type": "string"
    },
    "protocol_id": {
      "const": "repository_action.v2",
      "default": "repository_action.v2",
      "title": "Protocol Id",
      "type": "string"
    },
    "protocol_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "resolver_id": {
      "const": "repository_action_protocol_resolver_v1",
      "default": "repository_action_protocol_resolver_v1",
      "title": "Resolver Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_machine_id": {
      "enum": [
        "repository_action_state_machine_v1",
        "repository_action_state_machine_v2",
        "repository_action_state_machine_v3"
      ],
      "title": "State Machine Id",
      "type": "string"
    },
    "task_tool_contract_hash": {
      "title": "Task Tool Contract Hash",
      "type": "string"
    }
  },
  "required": [
    "action_transport",
    "action_registry_hash",
    "prompt_contract_id",
    "prompt_contract_hash",
    "normalizer_id",
    "state_machine_id",
    "max_completion_calls",
    "max_response_bytes",
    "agent_descriptor_hash",
    "task_tool_contract_hash",
    "configuration_fingerprint"
  ],
  "title": "RepositoryActionProtocolDescriptor",
  "type": "object"
}
