{
  "$defs": {
    "RepositoryActionNormalization": {
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "items": {
            "enum": [
              "utf8_decoded",
              "leading_bom_removed",
              "line_endings_normalized",
              "outer_whitespace_stripped",
              "response_wide_json_fence_unwrapped",
              "response_wide_unlabeled_fence_unwrapped"
            ],
            "type": "string"
          },
          "title": "Decisions",
          "type": "array"
        },
        "normalized_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Bytes"
        },
        "normalized_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Sha256"
        },
        "raw_bytes": {
          "minimum": 0,
          "title": "Raw Bytes",
          "type": "integer"
        },
        "raw_sha256": {
          "title": "Raw Sha256",
          "type": "string"
        },
        "representation_only": {
          "const": true,
          "default": true,
          "title": "Representation Only",
          "type": "boolean"
        }
      },
      "required": [
        "raw_sha256",
        "raw_bytes"
      ],
      "title": "RepositoryActionNormalization",
      "type": "object"
    }
  },
  "$id": "https://verigym.dev/schemas/1.0/repository-action-turn-record.schema.json",
  "additionalProperties": false,
  "description": "Replayable, bounded decision record for one completion turn.",
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "action_envelope_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Envelope Hash"
    },
    "action_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Name"
    },
    "arguments_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arguments Hash"
    },
    "error_subcategory": {
      "anyOf": [
        {
          "enum": [
            "agent_empty_output",
            "agent_malformed_json",
            "agent_non_object_json",
            "agent_extra_prose",
            "agent_multiple_actions",
            "agent_unknown_action",
            "agent_invalid_arguments",
            "agent_unsupported_transport",
            "agent_response_oversized",
            "agent_turn_budget_exhausted",
            "agent_invalid_state_transition",
            "agent_finish_invalid"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Subcategory"
    },
    "normalization": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepositoryActionNormalization"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "permitted_normalization_used": {
      "default": false,
      "title": "Permitted Normalization Used",
      "type": "boolean"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_after": {
      "anyOf": [
        {
          "enum": [
            "awaiting_action",
            "candidate_modified",
            "public_test_observed",
            "diff_observed",
            "finished"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State After"
    },
    "state_before": {
      "enum": [
        "awaiting_action",
        "candidate_modified",
        "public_test_observed",
        "diff_observed",
        "finished"
      ],
      "title": "State Before",
      "type": "string"
    },
    "termination_reason": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Termination Reason"
    },
    "tool_result_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Result Hash"
    },
    "transport": {
      "enum": [
        "json_content",
        "native_tool_call"
      ],
      "title": "Transport",
      "type": "string"
    },
    "turn_index": {
      "minimum": 0,
      "title": "Turn Index",
      "type": "integer"
    },
    "validation_result": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "Validation Result",
      "type": "string"
    }
  },
  "required": [
    "turn_index",
    "request_id",
    "transport",
    "state_before",
    "accepted",
    "validation_result"
  ],
  "title": "RepositoryActionTurnRecord",
  "type": "object"
}
