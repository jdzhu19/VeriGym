  "$id": "https://verigym.dev/schemas/1.0/experiment-manifest.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_locations": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifact Locations",
      "type": "object"
    },
    "build_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/BuildProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "evaluation_config_hash": {
      "title": "Evaluation Config Hash",
      "type": "string"
    },
    "execution_policy": {
      "$ref": "#/$defs/ExperimentExecutionConfig"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "planned_item_count": {
      "minimum": 1,
      "title": "Planned Item Count",
      "type": "integer"
    },
    "release_ids": {
      "items": {
        "type": "string"
      },
      "title": "Release Ids",
      "type": "array"
    },
    "resolved_profile_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Resolved Profile Hashes",
      "type": "array"
    },
    "runtime_identities": {
      "items": {
        "$ref": "#/$defs/RuntimeDescriptor"
      },
      "title": "Runtime Identities",
      "type": "array"
    },
    "sampling_policy": {
      "$ref": "#/$defs/ExperimentRunsConfig"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_task_count": {
      "minimum": 1,
      "title": "Selected Task Count",
      "type": "integer"
    },
    "source_identity_hash": {
      "title": "Source Identity Hash",
      "type": "string"
    },
    "status": {
      "default": "planned",
      "enum": [
        "planned",
        "running",
        "interrupted",
        "completed",
        "completed_with_infrastructure_errors",
        "failed_configuration",
        "failed_internal",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "suite_id": {
      "title": "Suite Id",
      "type": "string"
    },
    "suite_source_snapshots": {
      "items": {
        "$ref": "#/$defs/SuiteSourceSnapshot"
      },
      "title": "Suite Source Snapshots",
      "type": "array"
    },
    "suite_versions": {
      "items": {
        "type": "string"
      },
      "title": "Suite Versions",
      "type": "array"
    },
    "system_identities": {
      "items": {
        "$ref": "#/$defs/PlannedSystemIdentity"
      },
      "title": "System Identities",
      "type": "array"
    },
    "task_set_hash": {
      "title": "Task Set Hash",
      "type": "string"
    },
    "verigym_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verigym Commit"
    },
    "verigym_version": {
      "title": "Verigym Version",
      "type": "string"
    }
  },
  "required": [
    "experiment_id",
    "created_at_utc",
    "config_hash",
    "evaluation_config_hash",
    "plan_hash",
    "task_set_hash",
    "source_identity_hash",
    "suite_id",
    "suite_versions",
    "verigym_version",
    "selected_task_count",
    "planned_item_count",
    "system_identities",
    "runtime_identities",
    "sampling_policy",
    "execution_policy",
    "artifact_locations"
  ],
  "title": "ExperimentManifest",
  "type": "object"
}
