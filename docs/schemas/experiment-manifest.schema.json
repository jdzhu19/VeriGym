      "required": [
        "name",
        "version",
        "provider",
        "model_id"
      ],
      "title": "ModelDescriptor",
      "type": "object"
    },
    "ModelRunConfig": {
      "additionalProperties": false,
      "description": "Secret-free per-run options understood by compatible model clients.",
      "properties": {
        "api_key_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key Env"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "base_url_env": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url Env"
        },
        "client_options": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Client Options",
          "type": "object"
        },
        "connect_timeout_s": {
          "default": 10.0,
          "exclusiveMinimum": 0.0,
          "title": "Connect Timeout S",
          "type": "number"
        },
        "max_response_bytes": {
          "default": 4194304,
          "maximum": 67108864,
          "minimum": 1024,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "provider_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "read_timeout_s": {
          "default": 60.0,
          "exclusiveMinimum": 0.0,
          "title": "Read Timeout S",
          "type": "number"
        },
        "request_timeout_s": {
          "default": 90.0,
          "exclusiveMinimum": 0.0,
          "title": "Request Timeout S",
          "type": "number"
        },
        "require_exact_model_id": {
          "default": false,
          "title": "Require Exact Model Id",
          "type": "boolean"
        },
        "sample_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Index"
        },
        "temperature": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "ModelRunConfig",
      "type": "object"
    },
