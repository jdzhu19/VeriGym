{
  "$defs": {
    "AgentDescriptor": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "default": "1.0",
          "title": "Api Version",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "provider"
      ],
      "title": "AgentDescriptor",
      "type": "object"
    },
    "BuildProvenance": {
      "additionalProperties": false,
      "description": "Secret-free identity for the source state that produced this package.",
      "properties": {
        "build_backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Backend"
        },
        "build_source_date_epoch": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Source Date Epoch"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dirty"
        },
        "installed_distribution_metadata_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installed Distribution Metadata Hash"
        },
        "package_name": {
          "default": "verigym",
          "title": "Package Name",
          "type": "string"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "provenance_method": {
          "enum": [
            "git_live_editable",
            "embedded_build",
            "embedded_source_archive",
            "unknown"
          ],
          "title": "Provenance Method",
          "type": "string"
        },
        "python_build_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python Build Version"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_archive_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Archive Hash"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_tree_file_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Tree File Count"
        },
        "source_tree_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Tree Hash"
        },
        "source_tree_path_policy": {
          "title": "Source Tree Path Policy",
          "type": "string"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Reason"
        }
      },
      "required": [
        "package_version",
        "provenance_method",
        "source_tree_path_policy"
      ],
      "title": "BuildProvenance",
      "type": "object"
    },
    "ExperimentExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "continue_on_infrastructure_error": {
          "default": true,
          "title": "Continue On Infrastructure Error",
          "type": "boolean"
        },
        "frozen_campaign_identity": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Frozen Campaign Identity",
          "type": "object"
        },
        "max_consecutive_identical_shared_infrastructure_failures": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Consecutive Identical Shared Infrastructure Failures"
        },
        "max_model_api_calls": {
          "anyOf": [
            {
              "maximum": 3200000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Api Calls"
        },
        "max_model_processes": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Processes"
        },
        "max_plan_items": {
          "default": 10000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Plan Items",
          "type": "integer"
        },
        "max_total_infrastructure_failures": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Infrastructure Failures"
        },
        "max_workers": {
          "default": 1,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Workers",
          "type": "integer"
        },
        "plan_order_policy": {
          "default": "canonical",
          "enum": [
            "canonical",
            "counterbalanced_systems_v1"
          ],
          "title": "Plan Order Policy",
          "type": "string"
        },
        "resume_model_process_policy": {
          "default": "legacy_rerun_invalid",
          "enum": [
            "legacy_rerun_invalid",
            "never_rerun_after_authorization"
          ],
          "title": "Resume Model Process Policy",
          "type": "string"
        },
        "seal_plan_before_execution": {
          "default": false,
          "title": "Seal Plan Before Execution",
          "type": "boolean"
        },
        "summary_checkpoint_interval": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Checkpoint Interval"
        }
      },
      "title": "ExperimentExecutionConfig",
      "type": "object"
    },
    "ExperimentRunsConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/InteractionMode",
          "default": "agent"
        },
        "pass_k": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Pass K",
          "type": "array"
        },
        "samples_per_task": {
          "default": 1,
          "maximum": 1024,
          "minimum": 1,
          "title": "Samples Per Task",
          "type": "integer"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Seeds",
          "type": "array"
        }
      },
      "title": "ExperimentRunsConfig",
      "type": "object"
    },
    "InteractionMode": {
      "enum": [
        "chat",
        "agent",
        "train"
      ],
      "title": "InteractionMode",
      "type": "string"
    },
    "JsonValue": {},
    "ModelDescriptor": {
      "additionalProperties": false,
      "properties": {
        "api_compatibility": {
          "default": "verigym.model.v1",
